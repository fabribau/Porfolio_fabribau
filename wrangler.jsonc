{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "porfolio-fabribau",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}

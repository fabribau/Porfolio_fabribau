---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@i18n/utils';
import Badge from '@components/Badge.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const currentYear = new Date().getFullYear();

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/fabribau', icon: 'github' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/fabrizio-bauer', icon: 'linkedin' },
  { label: 'WhatsApp', href: 'https://wa.me/5492664024353', icon: 'whatsapp' },
  { label: 'Email', href: 'mailto:fabriziojriera@gmail.com', icon: 'mail' },
];

const quickLinks = [
  { label: t('nav.home'), href: translatePath('/') },
  { label: t('nav.about'), href: translatePath('/about') },
  { label: t('nav.projects'), href: translatePath('/proyectos') },
  { label: t('nav.blog'), href: translatePath('/blog') },
  { label: t('nav.contact'), href: translatePath('/contact') },
  { label: t('nav.style_guide'), href: translatePath('/style-guide') },
];
---

<footer
  class="mt-20 border-t-4 border-black bg-bg-surface-light transition-colors duration-200 dark:border-white dark:bg-bg-surface-dark"
>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div
      class="grid grid-cols-1 gap-8 border-b-2 border-black/20 pb-10 dark:border-white/20 md:grid-cols-3"
    >
      <!-- Col 1: Brand & Status -->
      <div class="space-y-4">
        <a
          href={translatePath('/')}
          class="group inline-flex cursor-pointer select-none flex-wrap items-center py-1"
          aria-label="Fabrizio Riera Bauer - Home"
        >
          <span
            class="border-2 border-black bg-accent-yellow px-3 py-1 font-display text-base font-black text-black shadow-[2px_2px_0px_0px_var(--shadow-color)] transition-all duration-200 ease-out [text-shadow:1px_1px_0px_rgba(0,0,0,0.3)] group-hover:-translate-x-2 group-hover:-rotate-3 group-hover:shadow-[4px_4px_0px_0px_var(--shadow-color)] dark:border-white md:text-lg"
          >
            FAB
          </span>
          <span
            class="-ml-[2px] border-2 border-black bg-accent-pink px-3 py-1 font-display text-base font-black text-white shadow-[2px_2px_0px_0px_var(--shadow-color)] transition-all duration-200 ease-out [text-shadow:1.5px_1.5px_0px_#0D0D0D] group-hover:ml-1 group-hover:-translate-y-1.5 group-hover:shadow-[4px_4px_0px_0px_var(--shadow-color)] dark:border-white md:text-lg"
          >
            RI
          </span>
          <span
            class="-ml-[2px] border-2 border-black bg-accent-cyan px-3 py-1 font-display text-base font-black text-black shadow-[2px_2px_0px_0px_var(--shadow-color)] transition-all duration-200 ease-out [text-shadow:1px_1px_0px_rgba(0,0,0,0.3)] group-hover:ml-1 group-hover:translate-x-1.5 group-hover:rotate-3 group-hover:shadow-[4px_4px_0px_0px_var(--shadow-color)] dark:border-white md:text-lg"
          >
            BAU
          </span>
          <span
            class="-ml-[2px] border-2 border-black bg-accent-lime px-3 py-1 font-display text-base font-black text-black shadow-[2px_2px_0px_0px_var(--shadow-color)] transition-all duration-200 ease-out [text-shadow:1px_1px_0px_rgba(0,0,0,0.3)] group-hover:ml-2 group-hover:translate-x-3 group-hover:shadow-[4px_4px_0px_0px_var(--shadow-color)] dark:border-white md:text-lg"
          >
            .TECH
          </span>
        </a>
        <p
          class="max-w-sm font-sans text-xs leading-relaxed text-fg-muted-light dark:text-fg-muted-dark"
        >
          {t('hero.role')} — {t('hero.desc')}
        </p>
        <div>
          <Badge color="lime" pulse={true} size="sm">
            {t('footer.status')}
          </Badge>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="space-y-3">
        <h3
          class="flex items-center gap-2 font-display text-sm font-black uppercase tracking-wider text-black dark:text-white"
        >
          <span
            class="inline-block h-2.5 w-2.5 border border-black bg-accent-yellow dark:border-white"
          ></span>
          {t('footer.quick_links')}
        </h3>
        <ul class="space-y-1.5 font-mono text-xs">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-block text-fg-muted-light transition-transform hover:translate-x-1 hover:text-black dark:text-fg-muted-dark dark:hover:text-white"
                >
                  → {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Social / Contact -->
      <div class="space-y-3">
        <h3
          class="flex items-center gap-2 font-display text-sm font-black uppercase tracking-wider text-black dark:text-white"
        >
          <span
            class="inline-block h-2.5 w-2.5 border border-black bg-accent-pink dark:border-white"
          ></span>
          {t('footer.social')}
        </h3>
        <div class="flex flex-wrap gap-2">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="border-2 border-black bg-zinc-100 px-3 py-1.5 font-mono text-xs font-bold text-black shadow-brutal-sm transition-all hover:translate-x-0.5 hover:translate-y-0.5 hover:bg-accent-yellow hover:text-black hover:shadow-none dark:border-white dark:bg-zinc-800 dark:text-white"
              >
                {social.label} ↗
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="flex flex-col items-center justify-between gap-4 pt-6 font-mono text-xs text-fg-muted-light dark:text-fg-muted-dark sm:flex-row"
    >
      <p>© {currentYear} Fabrizio José Riera Bauer. {t('footer.rights')}</p>
      <div class="flex items-center gap-2">
        <span>{t('footer.built_with')}</span>
        <span class="bg-black px-1.5 py-0.5 font-bold text-white dark:bg-white dark:text-black"
          >Astro 5</span
        >
        <span class="bg-accent-cyan px-1.5 py-0.5 font-bold text-black">Tailwind</span>
        <span class="bg-accent-yellow px-1.5 py-0.5 font-bold text-black">Cloudflare</span>
      </div>
    </div>
  </div>
</footer>

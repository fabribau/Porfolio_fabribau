---
interface Props {
  title: string;
  subtitle?: string;
  number?: string;
  highlightColor?: 'yellow' | 'pink' | 'lime' | 'cyan';
  class?: string;
}

const {
  title,
  subtitle,
  number,
  highlightColor = 'yellow',
  class: className = '',
} = Astro.props;

const dotColorMap: Record<string, string> = {
  yellow: 'bg-accent-yellow',
  pink: 'bg-accent-pink',
  lime: 'bg-accent-lime',
  cyan: 'bg-accent-cyan',
};
---

<div class={`mb-8 ${className}`}>
  <div class="flex items-center gap-3 mb-2">
    {number && (
      <span class="font-mono text-xs font-black bg-black text-white dark:bg-white dark:text-black px-2 py-0.5 border-2 border-black dark:border-white shadow-[2px_2px_0px_0px_var(--shadow-color)]">
        /{number}
      </span>
    )}
    <span class={`w-3.5 h-3.5 ${dotColorMap[highlightColor] || 'bg-accent-yellow'} inline-block border-2 border-black dark:border-white shadow-[1px_1px_0px_0px_var(--shadow-color)]`}></span>
    <h2 class="font-display font-black text-2xl md:text-3xl lg:text-4xl tracking-tight text-black dark:text-white">
      {title}
    </h2>
  </div>

  {subtitle && (
    <p class="font-mono text-xs md:text-sm text-fg-muted-light dark:text-fg-muted-dark max-w-2xl pl-1">
      {subtitle}
    </p>
  )}
</div>

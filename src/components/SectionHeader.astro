---
interface Props {
  title: string;
  subtitle?: string;
  number?: string;
  highlightColor?: 'yellow' | 'pink' | 'lime' | 'cyan';
  class?: string;
}

const { title, subtitle, number, highlightColor = 'yellow', class: className = '' } = Astro.props;

const dotColorMap: Record<string, string> = {
  yellow: 'bg-accent-yellow',
  pink: 'bg-accent-pink',
  lime: 'bg-accent-lime',
  cyan: 'bg-accent-cyan',
};
---

<div class={`mb-8 ${className}`}>
  <div class="mb-2 flex items-center gap-3">
    {
      number && (
        <span class="border-2 border-black bg-black px-2 py-0.5 font-mono text-xs font-black text-white shadow-[2px_2px_0px_0px_var(--shadow-color)] dark:border-white dark:bg-white dark:text-black">
          /{number}
        </span>
      )
    }
    <span
      class={`w-3.5 h-3.5 ${dotColorMap[highlightColor] || 'bg-accent-yellow'} inline-block border-2 border-black dark:border-white shadow-[1px_1px_0px_0px_var(--shadow-color)]`}
    ></span>
    <h2
      class="font-display text-2xl font-black tracking-tight text-black dark:text-white md:text-3xl lg:text-4xl"
    >
      {title}
    </h2>
  </div>

  {
    subtitle && (
      <p class="max-w-2xl pl-1 font-mono text-xs text-fg-muted-light dark:text-fg-muted-dark md:text-sm">
        {subtitle}
      </p>
    )
  }
</div>

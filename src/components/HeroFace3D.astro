---
/**
 * HeroFace3D.astro
 * 
 * Avatar 3D interactivo con estética Neobrutalista para la sección Hero (Desktop).
 * - Arquitectura modular de capas (base, cejas, ojos, boca, partículas).
 * - Seguimiento de cursor con perspectiva 3D y pupilas reactivas.
 * - Reacción a mimos / clics: satisfacción, asentimiento elástico y partícula flotante 👍 (+1).
 * - Reacción a golpes / clics repetidos: retroceso físico, sacudida, ceño fruncido y partículas de molestia.
 * - Preparado para sustituir fácilmente las capas faciales por la ilustración de Fabrizio.
 */
---

<div class="relative flex flex-col items-center justify-center p-2 select-none" id="hero-face-container">
  <!-- 3D Perspective Wrapper -->
  <div 
    class="relative cursor-pointer" 
    id="hero-face-card"
    style="perspective: 1000px; transform-style: preserve-3d;"
    role="button"
    tabindex="0"
    aria-label="Avatar interactivo 3D"
  >
    <!-- Neobrutalist Face Container (Ready to swap with custom illustration) -->
    <div 
      id="face-head"
      class="relative w-48 h-48 sm:w-56 sm:h-56 md:w-60 md:h-60 rounded-3xl border-4 border-black bg-white shadow-brutal-lg transition-shadow duration-200 hover:shadow-brutal-xl active:translate-x-0.5 active:translate-y-0.5 overflow-hidden flex items-center justify-center touch-manipulation dark:border-black"
      style="transform-style: preserve-3d; will-change: transform;"
    >
      <!-- Subtle Neobrutalist Grid / Tech Texture Background -->
      <div 
        class="absolute inset-0 opacity-[0.04] pointer-events-none"
        style="background-image: radial-gradient(#000 1.5px, transparent 1.5px); background-size: 14px 14px;"
      ></div>

      <!-- SVG AVATAR LAYERS (Modular & Layered) -->
      <svg 
        viewBox="0 0 200 200" 
        class="w-full h-full p-2 overflow-visible"
        id="face-svg"
      >
        <!-- ========================================== -->
        <!-- [LAYER 1]: HAIR / HEAD ACCENT (Developer style) -->
        <!-- ========================================== -->
        <g id="layer-hair">
          <!-- Sleek geometric dark fringe / hair crop -->
          <path 
            d="M 38 52 C 45 32, 75 22, 100 22 C 125 22, 155 32, 162 52 C 150 48, 132 46, 120 54 C 110 46, 90 46, 80 54 C 68 46, 50 48, 38 52 Z" 
            fill="#A47A3F" 
            stroke="#18181B" 
            stroke-width="2" 
          />
        </g>

        <!-- ========================================== -->
        <!-- [LAYER 2]: EYEBROWS (Reactive & Expressive) -->
        <!-- ========================================== -->
        <g id="layer-eyebrows">
          <!-- Left Eyebrow -->
          <g id="brow-left-group" style="transform-origin: 60px 68px;">
            <rect 
              id="brow-left"
              x="42" 
              y="65" 
              width="36" 
              height="7" 
              rx="3.5" 
              fill="#A47A3F" 
            />
          </g>

          <!-- Right Eyebrow -->
          <g id="brow-right-group" style="transform-origin: 140px 68px;">
            <rect 
              id="brow-right"
              x="122" 
              y="65" 
              width="36" 
              height="7" 
              rx="3.5" 
              fill="#A47A3F" 
            />
          </g>
        </g>

        <!-- ========================================== -->
        <!-- [LAYER 3]: EYES & PUPILS (Mouse Tracking)   -->
        <!-- ========================================== -->
        <g id="layer-eyes">
          <!-- Left Eye Socket -->
          <g id="eye-socket-left" style="transform-box: fill-box; transform-origin: center;">
            <rect 
              x="40" 
              y="82" 
              width="40" 
              height="44" 
              rx="20" 
              fill="#FFFFFF" 
              stroke="#18181B" 
              stroke-width="4" 
            />
            <!-- Left Pupil (Smoothly follows mouse) -->
            <g id="pupil-left" class="will-change-transform">
              <circle cx="60" cy="104" r="11" fill="#4f7942" />
              <circle cx="56" cy="100" r="3.5" fill="#FFFFFF" />
              <circle cx="63" cy="107" r="1.5" fill="#FFFFFF" />
            </g>
            <!-- Left Eye Wink / Happy Expression (Hidden by default) -->
            <path 
              id="eye-happy-left" 
              d="M 44 104 Q 60 88 76 104" 
              fill="none" 
              stroke="#18181B" 
              stroke-width="5" 
              stroke-linecap="round" 
              class="opacity-0 transition-opacity duration-150"
            />
            <!-- Left Eye Annoyed / Hit Expression (Hidden by default) -->
            <path 
              id="eye-annoyed-left" 
              d="M 44 104 L 76 104" 
              fill="none" 
              stroke="#18181B" 
              stroke-width="5" 
              stroke-linecap="round" 
              class="opacity-0 transition-opacity duration-150"
            />
          </g>

          <!-- Right Eye Socket -->
          <g id="eye-socket-right" style="transform-box: fill-box; transform-origin: center;">
            <rect 
              x="120" 
              y="82" 
              width="40" 
              height="44" 
              rx="20" 
              fill="#FFFFFF" 
              stroke="#18181B" 
              stroke-width="4" 
            />
            <!-- Right Pupil (Smoothly follows mouse) -->
            <g id="pupil-right" class="will-change-transform">
              <circle cx="140" cy="104" r="11" fill="#4f7942" />
              <circle cx="136" cy="100" r="3.5" fill="#FFFFFF" />
              <circle cx="143" cy="107" r="1.5" fill="#FFFFFF" />
            </g>
            <!-- Right Eye Wink / Happy Expression (Hidden by default) -->
            <path 
              id="eye-happy-right" 
              d="M 124 104 Q 140 88 156 104" 
              fill="none" 
              stroke="#18181B" 
              stroke-width="5" 
              stroke-linecap="round" 
              class="opacity-0 transition-opacity duration-150"
            />
            <!-- Right Eye Annoyed / Hit Expression (Hidden by default) -->
            <path 
              id="eye-annoyed-right" 
              d="M 124 104 L 156 104" 
              fill="none" 
              stroke="#18181B" 
              stroke-width="5" 
              stroke-linecap="round" 
              class="opacity-0 transition-opacity duration-150"
            />
          </g>
        </g>

        <!-- ========================================== -->
        <!-- [LAYER 4]: CHEEKS (Subtle Approval Blush)   -->
        <!-- ========================================== -->
        <g id="layer-cheeks">
          <ellipse 
            id="cheek-left" 
            cx="44" 
            cy="132" 
            rx="8" 
            ry="4" 
            fill="#FF3D8A" 
            class="opacity-0 transition-opacity duration-200" 
          />
          <ellipse 
            id="cheek-right" 
            cx="156" 
            cy="132" 
            rx="8" 
            ry="4" 
            fill="#FF3D8A" 
            class="opacity-0 transition-opacity duration-200" 
          />
        </g>

        <!-- ========================================== -->
        <!-- [LAYER 5]: NOSE (Minimal Neobrutalist Mark) -->
        <!-- ========================================== -->
        <g id="layer-nose">
          <path 
            d="M 100 108 L 96 118 L 103 118" 
            fill="none" 
            stroke="#18181B" 
            stroke-width="3.5" 
            stroke-linecap="round" 
            stroke-linejoin="round" 
          />
        </g>

        <!-- ========================================== -->
        <!-- [LAYER 6]: MOUTH (Dynamic Morph / Reaction)-->
        <!-- ========================================== -->
        <g id="layer-mouth">
          <!-- Neutral / Smirk Mouth -->
          <path 
            id="mouth-neutral" 
            d="M 86 142 Q 100 148 114 142" 
            fill="none" 
            stroke="#18181B" 
            stroke-width="4.5" 
            stroke-linecap="round" 
            class="transition-opacity duration-150"
          />
          <!-- Happy Smile (Shown on like) -->
          <path 
            id="mouth-happy" 
            d="M 82 139 Q 100 156 118 139" 
            fill="none" 
            stroke="#18181B" 
            stroke-width="4.5" 
            stroke-linecap="round" 
            class="opacity-0 transition-opacity duration-150"
          />
          <!-- Annoyed / Grumpy Mouth (Shown on hit) -->
          <path 
            id="mouth-annoyed" 
            d="M 84 147 Q 100 139 116 147" 
            fill="none" 
            stroke="#18181B" 
            stroke-width="4.5" 
            stroke-linecap="round" 
            class="opacity-0 transition-opacity duration-150"
          />
        </g>

        <!-- ========================================== -->
        <!-- [LAYER 7]: TECH DETAIL (Neobrutalist Accent) -->
        <!-- ========================================== -->
        <g id="layer-tech-accent" class="opacity-40">
          <rect x="16" y="16" width="6" height="6" fill="#18181B" />
          <rect x="178" y="16" width="6" height="6" fill="#18181B" />
          <line x1="16" y1="184" x2="32" y2="184" stroke="#18181B" stroke-width="2" />
          <line x1="168" y1="184" x2="184" y2="184" stroke="#18181B" stroke-width="2" />
        </g>
      </svg>

      <!-- Hit Impact Sweat / Anger Mark Overlay -->
      <div 
        id="face-impact-symbol" 
        class="absolute -top-1 -right-1 font-black text-2xl select-none opacity-0 pointer-events-none transition-transform duration-100"
      >
        💢
      </div>
    </div>
  </div>

  <!-- Floating Particles Container (Rendered in 2D space above 3D layers to eliminate any clipping) -->
  <div 
    id="face-particles-container" 
    class="absolute inset-0 pointer-events-none z-50 overflow-visible"
  ></div>
</div>

<script>
  import { animate, spring } from 'animejs';

  function initHeroFace() {
    const rawContainer = document.getElementById('hero-face-container');
    const rawCard = document.getElementById('hero-face-card');
    const rawHead = document.getElementById('face-head');
    const rawPupilLeft = document.getElementById('pupil-left');
    const rawPupilRight = document.getElementById('pupil-right');

    if (!rawContainer || !rawCard || !rawHead || !rawPupilLeft || !rawPupilRight) return;

    const container: HTMLElement = rawContainer;
    const card: HTMLElement = rawCard;
    const head: HTMLElement = rawHead;
    const pupilLeft: SVGElement = rawPupilLeft as unknown as SVGElement;
    const pupilRight: SVGElement = rawPupilRight as unknown as SVGElement;

    const browLeftGroup = document.getElementById('brow-left-group');
    const browRightGroup = document.getElementById('brow-right-group');
    const eyeHappyLeft = document.getElementById('eye-happy-left');
    const eyeHappyRight = document.getElementById('eye-happy-right');
    const eyeAnnoyedLeft = document.getElementById('eye-annoyed-left');
    const eyeAnnoyedRight = document.getElementById('eye-annoyed-right');
    const cheekLeft = document.getElementById('cheek-left');
    const cheekRight = document.getElementById('cheek-right');
    const mouthNeutral = document.getElementById('mouth-neutral');
    const mouthHappy = document.getElementById('mouth-happy');
    const mouthAnnoyed = document.getElementById('mouth-annoyed');
    const impactSymbol = document.getElementById('face-impact-symbol');
    const particlesContainer = document.getElementById('face-particles-container');

    // --- State variables ---
    let isAnnoyed = false;
    let isSatisfied = false;
    let annoyedTimeout: ReturnType<typeof setTimeout> | null = null;
    let satisfactionTimeout: ReturnType<typeof setTimeout> | null = null;
    let blinkInterval: ReturnType<typeof setInterval> | null = null;
    let clickTimestamps: number[] = [];

    // Current & target 3D transform values for smooth interpolation
    let currentRotateX = 0;
    let currentRotateY = 0;
    let targetRotateX = 0;
    let targetRotateY = 0;

    let currentPupilX = 0;
    let currentPupilY = 0;
    let targetPupilX = 0;
    let targetPupilY = 0;

    let rafId: number | null = null;

    // --- Smooth Render Loop ---
    function renderLoop() {
      if (!isAnnoyed) {
        // Smooth lerp towards target mouse values
        const lerpFactor = 0.12;
        currentRotateX += (targetRotateX - currentRotateX) * lerpFactor;
        currentRotateY += (targetRotateY - currentRotateY) * lerpFactor;
        currentPupilX += (targetPupilX - currentPupilX) * lerpFactor;
        currentPupilY += (targetPupilY - currentPupilY) * lerpFactor;

        head.style.transform = `rotateX(${currentRotateX.toFixed(2)}deg) rotateY(${currentRotateY.toFixed(2)}deg)`;
        pupilLeft.style.transform = `translate(${currentPupilX.toFixed(2)}px, ${currentPupilY.toFixed(2)}px)`;
        pupilRight.style.transform = `translate(${currentPupilX.toFixed(2)}px, ${currentPupilY.toFixed(2)}px)`;
      }

      rafId = requestAnimationFrame(renderLoop);
    }
    rafId = requestAnimationFrame(renderLoop);

    let lastInteractionTime = Date.now();
    let idleGlanceInterval: ReturnType<typeof setInterval> | null = null;

    // --- Gaze calculation helper for mouse & touch ---
    function updateGaze(clientX: number, clientY: number) {
      if (isAnnoyed) return;
      lastInteractionTime = Date.now();

      const rect = head.getBoundingClientRect();
      const faceCenterX = rect.left + rect.width / 2;
      const faceCenterY = rect.top + rect.height / 2;

      // Relative delta normalized from screen bounds
      const deltaX = (clientX - faceCenterX) / (window.innerWidth / 2);
      const deltaY = (clientY - faceCenterY) / (window.innerHeight / 2);

      const clampedX = Math.max(-1, Math.min(1, deltaX));
      const clampedY = Math.max(-1, Math.min(1, deltaY));

      // 3D Head rotation
      targetRotateY = clampedX * 16;
      targetRotateX = -clampedY * 14;

      // Pupil offset inside eye sockets (clamped to 10px radius)
      targetPupilX = clampedX * 10;
      targetPupilY = clampedY * 9;
    }

    function handleMouseMove(e: MouseEvent) {
      updateGaze(e.clientX, e.clientY);
    }

    function handleTouchMove(e: TouchEvent) {
      if (!e.touches[0]) return;
      updateGaze(e.touches[0].clientX, e.touches[0].clientY);
    }

    function resetGaze() {
      if (isAnnoyed) return;
      targetRotateX = 0;
      targetRotateY = 0;
      targetPupilX = 0;
      targetPupilY = 0;
    }

    window.addEventListener('mousemove', handleMouseMove, { passive: true });
    window.addEventListener('touchmove', handleTouchMove, { passive: true });
    window.addEventListener('touchstart', handleTouchMove, { passive: true });
    window.addEventListener('touchend', resetGaze, { passive: true });
    container.addEventListener('mouseleave', resetGaze);

    // Mirada orgánica periódica cuando no hay interacción activa (ideal para mobile en reposo)
    idleGlanceInterval = setInterval(() => {
      if (isAnnoyed || isSatisfied) return;
      if (Date.now() - lastInteractionTime > 4500) {
        const glanceDir = Math.random() > 0.5 ? 1 : -1;
        targetRotateY = glanceDir * 7;
        targetPupilX = glanceDir * 6;
        targetRotateX = -2;
        targetPupilY = -2;

        setTimeout(() => {
          if (Date.now() - lastInteractionTime > 4500 && !isAnnoyed) {
            resetGaze();
          }
        }, 1300);
      }
    }, 5200);

    // --- Periodic Natural Blink ---
    function scheduleBlink() {
      blinkInterval = setInterval(() => {
        if (isAnnoyed || isSatisfied) return;

        // Quick anime.js blink on eye sockets (con from: 1 explícito y centro fijo)
        animate(['#eye-socket-left', '#eye-socket-right'], {
          scaleY: [
            { from: 1, to: 0.08, duration: 90, ease: 'inOutQuad' },
            { to: 1, duration: 110, ease: 'outQuad' }
          ]
        });
      }, 3800 + Math.random() * 2000);
    }
    scheduleBlink();

    // --- Spawn Floating "👍 (+1)" Like Particle (Desde el borde del recuadro) ---
    function spawnLikeParticle() {
      if (!particlesContainer || !head) return;

      const particle = document.createElement('div');
      particle.className =
        'absolute z-50 flex items-center gap-1.5 px-3 py-1 bg-accent-lime border-2 border-black font-mono font-black text-xs text-black shadow-[3px_3px_0px_#000] rounded-md pointer-events-none select-none whitespace-nowrap';
      particle.innerHTML = '<span>👍</span><span class="tracking-tight">+1</span>';

      const containerRect = particlesContainer.getBoundingClientRect();
      const headRect = head.getBoundingClientRect();

      // Posicionar exactamente en el borde superior del recuadro con un ligero jitter horizontal
      const headCenterX = headRect.left + headRect.width / 2 - containerRect.left;
      const headTopY = headRect.top - containerRect.top;

      const startX = headCenterX - 28 + (Math.random() - 0.5) * 40;
      const startY = headTopY - 16;

      particle.style.left = `${startX}px`;
      particle.style.top = `${startY}px`;

      particlesContainer.appendChild(particle);

      const driftX = (Math.random() - 0.5) * 28;
      const floatY = -(55 + Math.random() * 25);
      const randomRotate = (Math.random() - 0.5) * 18;

      animate(particle, {
        x: [0, driftX],
        y: [0, floatY],
        rotate: [0, randomRotate],
        scale: [
          { to: 1.2, duration: 150, ease: 'outBack' },
          { to: 0.95, duration: 400, ease: 'inOutQuad' }
        ],
        opacity: [
          { to: 1, duration: 80 },
          { to: 0, duration: 350, delay: 350, ease: 'inQuad' }
        ],
        onComplete: () => {
          particle.remove();
        }
      });
    }

    // --- Spawn Impact Spark Particle (Desde el borde en golpes) ---
    function spawnImpactSpark() {
      if (!particlesContainer || !head) return;

      const spark = document.createElement('div');
      spark.className =
        'absolute z-50 font-black text-sm text-black bg-accent-yellow border-2 border-black px-1.5 py-0.5 rounded shadow-[2px_2px_0px_#000] pointer-events-none select-none';
      spark.textContent = '💥';

      const containerRect = particlesContainer.getBoundingClientRect();
      const headRect = head.getBoundingClientRect();

      const startX = headRect.right - containerRect.left - 24;
      const startY = headRect.top - containerRect.top - 14;

      spark.style.left = `${startX}px`;
      spark.style.top = `${startY}px`;

      particlesContainer.appendChild(spark);

      animate(spark, {
        y: [0, -32],
        x: [0, 16],
        scale: [0.5, 1.3, 0],
        rotate: [(Math.random() - 0.5) * 30],
        opacity: [1, 0],
        duration: 400,
        ease: 'outQuad',
        onComplete: () => spark.remove()
      });
    }

    // --- Expression Switchers ---
    function setExpression(type: 'neutral' | 'happy' | 'annoyed') {
      if (type === 'happy') {
        eyeHappyLeft?.classList.remove('opacity-0');
        eyeHappyRight?.classList.remove('opacity-0');
        pupilLeft?.classList.add('opacity-0');
        pupilRight?.classList.add('opacity-0');
        eyeAnnoyedLeft?.classList.add('opacity-0');
        eyeAnnoyedRight?.classList.add('opacity-0');

        cheekLeft?.classList.remove('opacity-0');
        cheekRight?.classList.remove('opacity-0');

        mouthNeutral?.classList.add('opacity-0');
        mouthHappy?.classList.remove('opacity-0');
        mouthAnnoyed?.classList.add('opacity-0');

        // Lift eyebrows in approval
        if (browLeftGroup) browLeftGroup.style.transform = 'rotate(-6deg) translateY(-2px)';
        if (browRightGroup) browRightGroup.style.transform = 'rotate(6deg) translateY(-2px)';
      } else if (type === 'annoyed') {
        eyeHappyLeft?.classList.add('opacity-0');
        eyeHappyRight?.classList.add('opacity-0');
        pupilLeft?.classList.add('opacity-0');
        pupilRight?.classList.add('opacity-0');
        eyeAnnoyedLeft?.classList.remove('opacity-0');
        eyeAnnoyedRight?.classList.remove('opacity-0');

        cheekLeft?.classList.add('opacity-0');
        cheekRight?.classList.add('opacity-0');

        mouthNeutral?.classList.add('opacity-0');
        mouthHappy?.classList.add('opacity-0');
        mouthAnnoyed?.classList.remove('opacity-0');

        // Furrow eyebrows down aggressively
        if (browLeftGroup) browLeftGroup.style.transform = 'rotate(18deg) translateY(4px)';
        if (browRightGroup) browRightGroup.style.transform = 'rotate(-18deg) translateY(4px)';
      } else {
        // Neutral
        eyeHappyLeft?.classList.add('opacity-0');
        eyeHappyRight?.classList.add('opacity-0');
        pupilLeft?.classList.remove('opacity-0');
        pupilRight?.classList.remove('opacity-0');
        eyeAnnoyedLeft?.classList.add('opacity-0');
        eyeAnnoyedRight?.classList.add('opacity-0');

        cheekLeft?.classList.add('opacity-0');
        cheekRight?.classList.add('opacity-0');

        mouthNeutral?.classList.remove('opacity-0');
        mouthHappy?.classList.add('opacity-0');
        mouthAnnoyed?.classList.add('opacity-0');

        if (browLeftGroup) browLeftGroup.style.transform = 'none';
        if (browRightGroup) browRightGroup.style.transform = 'none';
      }
    }

    // --- Action: SATISFACTION (Single Click / Cariño) ---
    function triggerSatisfaction() {
      if (isAnnoyed) return;
      isSatisfied = true;
      if (satisfactionTimeout) clearTimeout(satisfactionTimeout);

      setExpression('happy');
      spawnLikeParticle();

      // Elastic nod & stretch satisfaction bounce
      animate(head, {
        scaleX: [
          { to: 1.08, duration: 180, ease: 'outCubic' },
          { to: 1, duration: 320, ease: spring({ bounce: 0.5, duration: 350 }) }
        ],
        scaleY: [
          { to: 0.94, duration: 180, ease: 'outCubic' },
          { to: 1, duration: 320, ease: spring({ bounce: 0.5, duration: 350 }) }
        ],
        rotateZ: [
          { to: (Math.random() > 0.5 ? 4 : -4), duration: 160 },
          { to: 0, duration: 280, ease: 'outQuad' }
        ]
      });

      satisfactionTimeout = setTimeout(() => {
        if (!isAnnoyed) {
          setExpression('neutral');
          isSatisfied = false;
        }
      }, 550);
    }

    // --- Action: ANNOYED (Rapid clicks / Pegando) ---
    function triggerAnnoyed() {
      isAnnoyed = true;
      isSatisfied = false;
      if (satisfactionTimeout) clearTimeout(satisfactionTimeout);
      if (annoyedTimeout) clearTimeout(annoyedTimeout);

      setExpression('annoyed');

      // Impact symbols & sparks
      if (impactSymbol) {
        impactSymbol.style.opacity = '1';
        animate(impactSymbol, {
          scale: [0.6, 1.4, 1],
          rotate: [-15, 15, -8, 0],
          duration: 350,
          ease: 'outBack'
        });
      }

      spawnImpactSpark();

      // Violent recoil + lateral shake
      animate(head, {
        x: [0, -12, 12, -9, 9, -5, 5, -2, 2, 0],
        y: [0, 8, -4, 4, 0],
        rotateZ: [0, -8, 8, -5, 5, 0],
        scale: [1, 0.92, 1.02, 0.98, 1],
        duration: 550,
        ease: 'outCubic',
        onComplete: () => {
          // Pout mode: turn head away proudly/stubbornly
          if (isAnnoyed) {
            animate(head, {
              rotateY: -26,
              rotateX: 6,
              duration: 400,
              ease: 'outQuad'
            });
          }
        }
      });

      // Cool down after 2.2 seconds
      annoyedTimeout = setTimeout(() => {
        // Calming sigh
        animate(head, {
          rotateY: 0,
          rotateX: 0,
          scaleY: [1, 0.96, 1],
          duration: 450,
          ease: 'outQuad',
          onComplete: () => {
            setExpression('neutral');
            if (impactSymbol) impactSymbol.style.opacity = '0';
            isAnnoyed = false;
            clickTimestamps = [];
          }
        });
      }, 2200);
    }

    // --- Click Listener with Rapid-Click Detector ---
    card.addEventListener('click', () => {
      const now = Date.now();
      // Keep only clicks within the last 1200ms
      clickTimestamps = clickTimestamps.filter((t) => now - t < 1200);
      clickTimestamps.push(now);

      // 4 or more clicks in 1.2s triggers annoyed / hit state
      if (clickTimestamps.length >= 4) {
        triggerAnnoyed();
      } else {
        triggerSatisfaction();
      }
    });

    // Cleanup when Astro navigates
    document.addEventListener(
      'astro:before-swap',
      () => {
        if (rafId) cancelAnimationFrame(rafId);
        if (blinkInterval) clearInterval(blinkInterval);
        if (idleGlanceInterval) clearInterval(idleGlanceInterval);
        if (annoyedTimeout) clearTimeout(annoyedTimeout);
        if (satisfactionTimeout) clearTimeout(satisfactionTimeout);
        window.removeEventListener('mousemove', handleMouseMove);
        window.removeEventListener('touchmove', handleTouchMove);
        window.removeEventListener('touchstart', handleTouchMove);
        window.removeEventListener('touchend', resetGaze);
      },
      { once: true }
    );
  }

  // Initial load & View Transitions support
  document.addEventListener('astro:page-load', initHeroFace);
</script>

<style>
  #eye-socket-left,
  #eye-socket-right {
    transform-box: fill-box;
    transform-origin: center;
  }
</style>

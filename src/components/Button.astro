---
interface Props {
  variant?:
    'primary' | 'pink' | 'lime' | 'cyan' | 'purple' | 'secondary' | 'outline' | 'ghost' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  fullWidth?: boolean;
  class?: string;
  id?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  rel,
  type = 'button',
  disabled = false,
  fullWidth = false,
  class: className = '',
  id,
  ...rest
} = Astro.props;

// Variant styles
const variantStyles: Record<string, string> = {
  primary: 'bg-accent-yellow text-black border-black dark:border-white shadow-brutal',
  pink: 'bg-accent-pink text-white border-black dark:border-white shadow-brutal',
  lime: 'bg-accent-lime text-black border-black dark:border-white shadow-brutal',
  cyan: 'bg-accent-cyan text-black border-black dark:border-white shadow-brutal',
  purple: 'bg-accent-purple text-white border-black dark:border-white shadow-brutal',
  secondary:
    'bg-white dark:bg-zinc-800 text-black dark:text-white border-black dark:border-white shadow-brutal',
  outline: 'bg-transparent text-black dark:text-white border-black dark:border-white shadow-brutal',
  ghost:
    'bg-transparent text-black dark:text-white border-2 border-transparent shadow-none hover:bg-black/5 dark:hover:bg-white/5 hover:border-black/20 dark:hover:border-white/20 hover:shadow-none hover:translate-x-0 hover:translate-y-0',
  danger: 'bg-red-500 text-white border-black dark:border-white shadow-brutal',
};

// Size styles
const sizeStyles: Record<string, string> = {
  sm: 'px-3 py-1.5 text-xs gap-1.5 border-2',
  md: 'px-5 py-2.5 text-sm gap-2 border-3',
  lg: 'px-7 py-3.5 text-base gap-2.5 border-4',
};

const baseStyles = [
  'inline-flex items-center justify-center font-display font-bold uppercase tracking-wider select-none text-center',
  variant !== 'ghost' ? 'brutal-btn-press' : '',
  variantStyles[variant] || variantStyles.primary,
  sizeStyles[size] || sizeStyles.md,
  fullWidth ? 'w-full' : '',
  disabled
    ? 'opacity-50 cursor-not-allowed pointer-events-none shadow-none !translate-x-0 !translate-y-0'
    : 'cursor-pointer',
  className,
]
  .filter(Boolean)
  .join(' ');
---

{
  href && !disabled ? (
    <a
      href={href}
      target={target}
      rel={target === '_blank' ? rel || 'noopener noreferrer' : rel}
      class={baseStyles}
      id={id}
      {...rest}
    >
      <slot name="prefix" />
      <slot />
      <slot name="suffix" />
    </a>
  ) : (
    <button type={type} disabled={disabled} class={baseStyles} id={id} {...rest}>
      <slot name="prefix" />
      <slot />
      <slot name="suffix" />
    </button>
  )
}

---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@i18n/utils';
import LanguagePicker from '@components/LanguagePicker.astro';
import ThemeToggle from '@components/ThemeToggle.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const pathname = Astro.url.pathname;

const navItems = [
  { href: translatePath('/'), label: t('nav.home'), key: 'home' },
  { href: translatePath('/about'), label: t('nav.about'), key: 'about' },
  { href: translatePath('/proyectos'), label: t('nav.projects'), key: 'projects' },
  { href: translatePath('/blog'), label: t('nav.blog'), key: 'blog' },
  { href: translatePath('/contact'), label: t('nav.contact'), key: 'contact' },
];

const isCurrentPath = (href: string) => {
  if (href === translatePath('/') && (pathname === `/${lang}` || pathname === `/${lang}/`)) {
    return true;
  }
  if (href !== translatePath('/')) {
    return pathname.startsWith(href);
  }
  return pathname === href || pathname === `${href}/`;
};
---

<header
  class="sticky top-0 z-50 border-b-4 border-black bg-bg-surface-light transition-colors duration-200 dark:border-white dark:bg-bg-surface-dark"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <!-- Brand Logo -->
    <a
      href={translatePath('/')}
      class="group inline-flex cursor-pointer select-none items-center py-1"
      aria-label="Fabrizio Bauer - Home"
    >
      <span
        class="border-2 border-black bg-accent-yellow px-2.5 py-0.5 font-display text-base font-black text-black shadow-[2px_2px_0px_0px_var(--shadow-color)] transition-all duration-200 ease-out [text-shadow:1px_1px_0px_rgba(0,0,0,0.3)] group-hover:-translate-x-2 group-hover:-rotate-3 group-hover:shadow-[4px_4px_0px_0px_var(--shadow-color)] dark:border-white md:text-lg"
      >
        FAB
      </span>
      <span
        class="-ml-[2px] border-2 border-black bg-accent-pink px-2.5 py-0.5 font-display text-base font-black text-white shadow-[2px_2px_0px_0px_var(--shadow-color)] transition-all duration-200 ease-out [text-shadow:1.5px_1.5px_0px_#0D0D0D] group-hover:ml-1 group-hover:-translate-y-1.5 group-hover:shadow-[4px_4px_0px_0px_var(--shadow-color)] dark:border-white md:text-lg"
      >
        RI
      </span>
      <span
        class="-ml-[2px] border-2 border-black bg-accent-cyan px-2.5 py-0.5 font-display text-base font-black text-black shadow-[2px_2px_0px_0px_var(--shadow-color)] transition-all duration-200 ease-out [text-shadow:1px_1px_0px_rgba(0,0,0,0.3)] group-hover:ml-1 group-hover:translate-x-2 group-hover:rotate-3 group-hover:shadow-[4px_4px_0px_0px_var(--shadow-color)] dark:border-white md:text-lg"
      >
        BAU
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hidden items-center gap-1 font-display text-xs font-bold uppercase tracking-wider md:flex"
    >
      {
        navItems.map((item) => {
          const active = isCurrentPath(item.href);
          return (
            <a
              href={item.href}
              class={`border-2 px-3 py-1.5 transition-all ${
                active
                  ? '-translate-y-0.5 border-black bg-accent-yellow text-black shadow-[2px_2px_0px_0px_var(--shadow-color)]'
                  : 'border-transparent text-zinc-700 hover:border-black hover:bg-black/5 dark:text-zinc-300 dark:hover:border-white dark:hover:bg-white/5'
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Controls (Language, Theme & Mobile Toggle) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <LanguagePicker />
      <ThemeToggle />

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        class="brutal-btn border-2 border-black bg-white p-2 text-black shadow-brutal-sm dark:border-white dark:bg-zinc-800 dark:text-white md:hidden"
      >
        <svg
          id="hamburger-icon"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="3"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="close-icon"
          class="hidden h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="3"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="hidden space-y-2 border-t-3 border-black bg-bg-surface-light px-4 py-4 shadow-brutal-lg dark:border-white dark:bg-bg-surface-dark md:hidden"
  >
    {
      navItems.map((item) => {
        const active = isCurrentPath(item.href);
        return (
          <a
            href={item.href}
            class={`block border-2 border-black px-4 py-2.5 font-display text-sm font-black uppercase tracking-wider dark:border-white ${
              active
                ? 'bg-accent-yellow text-black shadow-brutal-sm'
                : 'bg-zinc-100 text-zinc-900 hover:bg-accent-pink hover:text-white dark:bg-zinc-800 dark:text-zinc-100'
            }`}
          >
            {item.label}
          </a>
        );
      })
    }
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!toggleBtn || !menu || !hamburgerIcon || !closeIcon) return;

    const toggle = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    };

    // Clean previous listener if reloaded
    toggleBtn.onclick = toggle;

    // Close when clicking any menu link
    menu.querySelectorAll('a').forEach((link) => {
      link.onclick = () => {
        if (!menu.classList.contains('hidden')) {
          toggle();
        }
      };
    });
  }

  // Initialize on first load and on View Transitions page swap
  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>

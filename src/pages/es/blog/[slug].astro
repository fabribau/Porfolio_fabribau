---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import Badge from '@components/Badge.astro';
import Tag from '@components/Tag.astro';
import { getCollection, render } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id }) => id.startsWith('es/'));
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^es\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout
  title={`${post.data.title} — Blog`}
  description={post.data.description}
  article={{
    pubDate: post.data.pubDate,
    tags: post.data.tags,
  }}
>
  <article class="space-y-8">
    <!-- Back button -->
    <div>
      <Button href={translatePath('/blog')} variant="secondary" size="sm">
        {t('common.back_blog')}
      </Button>
    </div>

    <!-- Post Header Box -->
    <header
      class="space-y-6 border-4 border-black bg-bg-surface-light p-6 shadow-brutal-xl dark:border-white dark:bg-bg-surface-dark md:p-10"
    >
      <div class="flex flex-wrap items-center justify-between gap-4">
        <Badge color="pink" size="md"> BLOG </Badge>
        <span class="font-mono text-sm font-bold text-fg-muted-light dark:text-fg-muted-dark">
          {t('common.published_on')}
          {
            post.data.pubDate.toLocaleDateString('es-AR', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </span>
      </div>

      <h1
        class="font-display text-3xl font-black leading-tight tracking-tight sm:text-4xl md:text-6xl"
      >
        {post.data.title}
      </h1>

      <p
        class="max-w-3xl text-base font-medium leading-relaxed text-fg-muted-light dark:text-fg-muted-dark sm:text-lg"
      >
        {post.data.description}
      </p>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 pt-2">
        {post.data.tags.map((tag) => <Tag>{tag}</Tag>)}
      </div>
    </header>

    <!-- Markdown Content Container -->
    <div
      class="prose dark:prose-invert prose-headings:font-display prose-headings:font-black prose-a:text-accent-pink dark:prose-a:text-accent-yellow prose-code:font-mono max-w-none border-4 border-black bg-white p-6 font-sans shadow-brutal-lg dark:border-white dark:bg-zinc-900 md:p-10"
    >
      <Content />
    </div>

    <!-- Bottom Navigation -->
    <div class="flex items-center justify-between pt-6">
      <Button href={translatePath('/blog')} variant="secondary" size="md">
        {t('common.back_blog')}
      </Button>
      <Button href={translatePath('/contact')} variant="primary" size="md">
        {t('hero.cta_contact')}
        <span slot="suffix">✉</span>
      </Button>
    </div>
  </article>
</BaseLayout>

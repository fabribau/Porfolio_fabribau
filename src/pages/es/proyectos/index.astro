---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/SectionHeader.astro';
import Card from '@components/Card.astro';
import Badge from '@components/Badge.astro';
import Tag from '@components/Tag.astro';
import Button from '@components/Button.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const allProjects = await getCollection('proyectos', ({ id }) => id.startsWith('es/'));
allProjects.sort((a, b) => {
  if (a.data.status === 'en-desarrollo' && b.data.status !== 'en-desarrollo') return -1;
  if (a.data.status !== 'en-desarrollo' && b.data.status === 'en-desarrollo') return 1;
  return b.data.pubDate.getTime() - a.data.pubDate.getTime();
});
---

<BaseLayout title={`${t('projects.title')} — Fabrizio Riera Bauer`} description={t('projects.subtitle')}>
  <div class="space-y-12">
    <!-- Header -->
    <SectionHeader
      number="01"
      title={t('projects.title')}
      subtitle={t('projects.subtitle')}
      highlightColor="yellow"
    />

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        allProjects.map((project) => {
          const slug = project.id.replace(/^es\//, '');
          const isDev = project.data.status === 'en-desarrollo';

          return (
            <Card
              variant="default"
              shadow="lg"
              hoverTilt="left"
              class="flex flex-col justify-between"
            >
              <div>
                <div class="mb-4 flex items-center justify-between gap-2">
                  <Badge color={isDev ? 'lime' : 'cyan'} pulse={isDev} size="sm">
                    {isDev ? t('project.status.in_progress') : t('project.status.completed')}
                  </Badge>
                  <span class="font-mono text-xs font-bold text-fg-muted-light dark:text-fg-muted-dark">
                    {project.data.pubDate.toLocaleDateString('es-AR', {
                      year: 'numeric',
                      month: 'short',
                    })}
                  </span>
                </div>

                <a href={translatePath(`/proyectos/${slug}`)} class="group mb-3 inline-block">
                  <h2 class="font-display text-2xl font-black tracking-tight transition-colors group-hover:text-accent-pink md:text-3xl">
                    {project.data.title}
                  </h2>
                </a>

                <p class="mb-6 text-sm leading-relaxed text-fg-muted-light dark:text-fg-muted-dark">
                  {project.data.description}
                </p>
              </div>

              <div>
                <div class="mb-6 flex flex-wrap gap-2">
                  {project.data.tags.map((tag) => (
                    <Tag>{tag}</Tag>
                  ))}
                </div>

                <div class="flex flex-wrap items-center gap-3 border-t-2 border-black/10 pt-4 dark:border-white/10">
                  <Button href={translatePath(`/proyectos/${slug}`)} variant="primary" size="sm">
                    {t('common.read_more')}
                    <span slot="suffix">→</span>
                  </Button>

                  {project.data.liveUrl && (
                    <Button
                      href={project.data.liveUrl}
                      target="_blank"
                      variant="secondary"
                      size="sm"
                    >
                      {t('project.live_demo')}
                      <span slot="suffix">↗</span>
                    </Button>
                  )}

                  {project.data.repositoryUrl && (
                    <Button
                      href={project.data.repositoryUrl}
                      target="_blank"
                      variant="ghost"
                      size="sm"
                    >
                      {t('common.view_code')}
                    </Button>
                  )}
                </div>
              </div>
            </Card>
          );
        })
      }
    </div>
  </div>
</BaseLayout>

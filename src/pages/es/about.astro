---
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeader from "@components/SectionHeader.astro";
import Card from "@components/Card.astro";
import Badge from "@components/Badge.astro";
import Tag from "@components/Tag.astro";
import Button from "@components/Button.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const skillCategories = [
  {
    title: t("about.skills_frontend"),
    skills: ["TypeScript", "JavaScript", "React", "Next.js", "Astro", "Tailwind CSS", "HTML5/CSS3"],
  },
  {
    title: t("about.skills_backend"),
    skills: ["Python", "Java", "Spring Boot", "FastAPI", "Node.js", "REST APIs", "Express"],
  },
  {
    title: t("about.skills_ai"),
    skills: ["RAG Systems", "LangChain", "LLMs", "Embeddings", "Prompt Engineering", "Vector DBs"],
  },
  {
    title: t("about.skills_databases"),
    skills: ["PostgreSQL", "MySQL", "Redis", "Cloudflare KV", "Prisma", "Drizzle"],
  },
  {
    title: t("about.skills_tools"),
    skills: ["Git", "GitHub Actions", "Docker", "Cloudflare Pages", "Linux", "VS Code"],
  },
];

const experienceList = [
  {
    period: "2023 — Presente",
    role: "Docente Auxiliar & Investigador en IA",
    org: "Universidad Nacional de San Luis (UNSL)",
    desc: "Dictado de clases universitarias en asignaturas de programación y sistemas. Investigación aplicada en arquitecturas de agentes conversacionales inteligentes con RAG y evaluación de modelos de lenguaje.",
    tags: ["Docencia", "Investigación", "Python", "RAG", "LLMs"],
  },
  {
    period: "2022 — Presente",
    role: "Desarrollador FullStack & Consultor de Software",
    org: "Proyectos Independientes & Sector Público",
    desc: "Diseño, arquitectura e implementación de aplicaciones web modernas, plataformas gubernamentales de alto tráfico y microservicios escalables.",
    tags: ["Astro", "React", "Next.js", "Spring Boot", "Tailwind CSS", "MySQL"],
  },
  {
    period: "2021 — 2022",
    role: "Desarrollador de Software",
    org: "RunaId",
    desc: "Desarrollo de funcionalidades frontend y backend, integración de APIs y mantenimiento evolutivo de soluciones digitales.",
    tags: ["JavaScript", "TypeScript", "Node.js", "REST API"],
  },
];

const educationList = [
  {
    period: "2019 — 2025",
    title: "Ingeniería en Informática",
    institution: "Universidad Nacional de San Luis (UNSL)",
    desc: "Graduado con Trabajo Final de Carrera enfocado en Inteligencia Artificial y agentes conversacionales RAG. Publicación en congreso nacional CoNaIISI 2025.",
  },
  {
    period: "2025",
    title: "Publicación Científica — CoNaIISI 2025",
    institution: "Congreso Nacional de Ingeniería Informática / Sistemas de Información",
    desc: "Artículo de investigación sobre agentes inteligentes con RAG para la prevención de adicciones digitales.",
  },
];
---

<BaseLayout
  title={`${t("about.title")} — Fabrizio José Riera Bauer`}
  description={t("about.subtitle")}
>
  <div class="space-y-12">
    <!-- Header Section -->
    <SectionHeader
      number="01"
      title={t("about.title")}
      subtitle={t("about.subtitle")}
      highlightColor="lime"
    />

    <!-- Profile Hero Card -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
      <!-- Photo / Profile Card -->
      <div class="p-6 bg-accent-yellow border-4 border-black dark:border-white shadow-brutal-lg flex flex-col items-center justify-center text-center space-y-4">
        <div class="relative w-44 h-44 sm:w-48 sm:h-48 border-4 border-black dark:border-white shadow-brutal overflow-hidden bg-zinc-900 group">
          <img
            src="/Fabri-paper.jpg"
            alt="Fabrizio José Riera Bauer"
            class="w-full h-full object-cover object-center grayscale contrast-125 group-hover:grayscale-0 transition-all duration-300"
            loading="eager"
          />
        </div>
        <div class="space-y-1">
          <h2 class="font-display font-black text-2xl text-black">
            Fabrizio Bauer
          </h2>
          <p class="font-mono text-xs font-bold text-zinc-800 uppercase">
            San Luis, Argentina
          </p>
        </div>
        <Badge color="dark" pulse={true} size="sm">
          {t("hero.badge")}
        </Badge>
      </div>

      <!-- Bio Summary -->
      <div class="md:col-span-2 p-6 md:p-8 bg-bg-surface-light dark:bg-bg-surface-dark border-4 border-black dark:border-white shadow-brutal-lg flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <h3 class="font-display font-black text-2xl md:text-3xl tracking-tight">
            {t("about.bio_title")}
          </h3>
          <p class="text-base text-fg-muted-light dark:text-fg-muted-dark leading-relaxed">
            {t("about.bio_p1")}
          </p>
          <p class="text-base text-fg-muted-light dark:text-fg-muted-dark leading-relaxed">
            {t("about.bio_p2")}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 pt-4 border-t-2 border-black/10 dark:border-white/10">
          <Button href={translatePath("/contact")} variant="pink" size="md">
            {t("hero.cta_contact")}
            <span slot="suffix">✉</span>
          </Button>
          <Button href="/CV-Empresas.pdf" target="_blank" download="CV-Fabrizio-Riera-Bauer.pdf" variant="cyan" size="md">
            {t("common.download_cv")}
            <span slot="suffix">↓</span>
          </Button>
          <Button href="/CV-Academico.pdf" target="_blank" download="CV-Academico-Fabrizio-Riera-Bauer.pdf" variant="purple" size="md">
            {t("common.download_cv_academic")}
            <span slot="suffix">🎓</span>
          </Button>
        </div>
      </div>
    </div>

    <!-- Experience Timeline -->
    <section class="space-y-6">
      <h3 class="font-display font-black text-2xl md:text-3xl flex items-center gap-3">
        <span class="w-3.5 h-3.5 bg-accent-pink inline-block border-2 border-black dark:border-white"></span>
        {t("about.experience_title")}
      </h3>

      <div class="space-y-6">
        {
          experienceList.map((exp) => (
            <Card variant="default" shadow="md">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                <div>
                  <h4 class="font-display font-black text-xl text-black dark:text-white">
                    {exp.role}
                  </h4>
                  <p class="font-mono text-sm font-bold text-accent-pink dark:text-accent-yellow">
                    {exp.org}
                  </p>
                </div>
                <Badge color="yellow" size="sm">
                  {exp.period}
                </Badge>
              </div>

              <p class="text-sm text-fg-muted-light dark:text-fg-muted-dark leading-relaxed mb-4">
                {exp.desc}
              </p>

              <div class="flex flex-wrap gap-1.5">
                {exp.tags.map((tag) => (
                  <Tag>{tag}</Tag>
                ))}
              </div>
            </Card>
          ))
        }
      </div>
    </section>

    <!-- Education & Achievements -->
    <section class="space-y-6">
      <h3 class="font-display font-black text-2xl md:text-3xl flex items-center gap-3">
        <span class="w-3.5 h-3.5 bg-accent-cyan inline-block border-2 border-black dark:border-white"></span>
        {t("about.education_title")}
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          educationList.map((edu) => (
            <Card variant="default" shadow="md" class="flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <Badge color="purple" size="sm">
                    {edu.period}
                  </Badge>
                </div>
                <h4 class="font-display font-black text-xl mb-1">
                  {edu.title}
                </h4>
                <p class="font-mono text-xs font-bold text-fg-muted-light dark:text-fg-muted-dark mb-3">
                  {edu.institution}
                </p>
                <p class="text-sm text-fg-muted-light dark:text-fg-muted-dark leading-relaxed">
                  {edu.desc}
                </p>
              </div>
            </Card>
          ))
        }
      </div>
    </section>

    <!-- Skills Categorized -->
    <section class="space-y-6">
      <h3 class="font-display font-black text-2xl md:text-3xl flex items-center gap-3">
        <span class="w-3.5 h-3.5 bg-accent-lime inline-block border-2 border-black dark:border-white"></span>
        {t("about.skills_title")}
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          skillCategories.map((cat) => (
            <Card variant="default" shadow="md">
              <h4 class="font-display font-black text-lg mb-4 flex items-center gap-2">
                <span class="w-2.5 h-2.5 bg-black dark:bg-white inline-block"></span>
                {cat.title}
              </h4>
              <div class="flex flex-wrap gap-2">
                {cat.skills.map((skill) => (
                  <Tag>{skill}</Tag>
                ))}
              </div>
            </Card>
          ))
        }
      </div>
    </section>

    <!-- Languages & Location -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <Card variant="yellow" shadow="md">
        <h4 class="font-display font-black text-xl text-black mb-3">
          🗣️ {t("about.languages_title")}
        </h4>
        <ul class="space-y-2 font-mono text-sm text-black font-medium">
          <li>• <strong>{t("about.lang_es")}</strong></li>
          <li>• <strong>{t("about.lang_en")}</strong></li>
        </ul>
      </Card>

      <Card variant="cyan" shadow="md">
        <h4 class="font-display font-black text-xl text-black mb-3">
          📍 {t("about.location_title")}
        </h4>
        <p class="text-sm text-black font-medium leading-relaxed">
          {t("about.location_desc")}
        </p>
      </Card>
    </section>
  </div>
</BaseLayout>

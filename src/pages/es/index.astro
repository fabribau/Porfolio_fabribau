---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import Card from '@components/Card.astro';
import Badge from '@components/Badge.astro';
import Tag from '@components/Tag.astro';
import SectionHeader from '@components/SectionHeader.astro';
import HeroFace3D from '@components/HeroFace3D.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath, formatDate } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Get projects and blog posts for Spanish
const allProjects = await getCollection('proyectos', ({ id }) => id.startsWith('es/'));
allProjects.sort((a, b) => {
  if (a.data.status === 'en-desarrollo' && b.data.status !== 'en-desarrollo') return -1;
  if (a.data.status !== 'en-desarrollo' && b.data.status === 'en-desarrollo') return 1;
  return b.data.pubDate.getTime() - a.data.pubDate.getTime();
});
const featuredProjects = allProjects.filter((p) => p.data.featured);

const allPosts = await getCollection('blog', ({ id, data }) => id.startsWith('es/') && !data.draft);
allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const latestPosts = allPosts.slice(0, 2);
---

<BaseLayout
  title="Fabrizio José Riera Bauer — Ingeniero en Informática & FullStack"
  description={t('hero.desc')}
>
  <div class="space-y-16">
    <!-- Hero Section -->
    <section class="reveal-on-scroll reveal-pop">
      <div
        class="border-4 border-black bg-accent-yellow p-6 text-black shadow-brutal-xl selection:bg-accent-pink selection:text-white dark:border-white md:p-12"
      >
        <div class="grid grid-cols-1 items-center gap-6 lg:grid-cols-12 lg:gap-8">
          <!-- 1. Hero Text (Top on mobile, left column row 1 on desktop) -->
          <div class="space-y-6 lg:col-span-8 lg:row-start-1">
            <div>
              <Badge color="dark" pulse={true} size="md">
                {t('hero.badge')}
              </Badge>
            </div>

            <div class="space-y-2">
              <p class="font-mono text-base font-bold text-zinc-900 sm:text-lg">
                {t('hero.greeting')}
              </p>
              <h1
                class="font-display text-4xl font-black leading-none tracking-tight text-black sm:text-6xl md:text-7xl"
              >
                {t('hero.title')}
              </h1>
            </div>

            <p class="font-mono text-base font-bold text-black sm:text-xl">
              {t('hero.role')}
            </p>

            <p class="max-w-2xl text-base font-medium leading-relaxed text-zinc-900 sm:text-lg">
              {t('hero.desc')}
            </p>
          </div>

          <!-- 2. Interactive 3D Avatar (Between text and buttons on mobile, right column on desktop) -->
          <div class="flex justify-center items-center py-2 lg:col-span-4 lg:col-start-9 lg:row-span-2 lg:row-start-1 lg:py-0">
            <HeroFace3D />
          </div>

          <!-- 3. CTA Buttons (Below avatar on mobile, left column row 2 on desktop) -->
          <div class="flex flex-wrap items-center gap-4 lg:col-span-8 lg:row-start-2">
            <Button href={translatePath('/proyectos')} variant="pink" size="lg">
              <Icon name="ph:lightning-bold" slot="prefix" class="h-5 w-5" />
              {t('hero.cta_projects')}
            </Button>
            <Button href={translatePath('/about')} variant="secondary" size="lg">
              {t('hero.cta_about')}
              <span slot="suffix">→</span>
            </Button>
            <Button href={translatePath('/contact')} variant="cyan" size="lg">
              {t('hero.cta_contact')}
              <Icon name="ph:envelope-simple-bold" slot="suffix" class="h-5 w-5" />
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- About Me Snippet Section -->
    <section class="reveal-on-scroll">
      <Card variant="default" shadow="lg">
        <div class="grid grid-cols-1 items-center gap-6 md:grid-cols-12">
          <div class="space-y-4 md:col-span-8">
            <div class="flex items-center gap-2">
              <span
                class="inline-block h-3 w-3 border border-black bg-accent-lime dark:border-white"
              ></span>
              <span
                class="font-mono text-xs font-bold uppercase tracking-wider text-fg-muted-light dark:text-fg-muted-dark"
              >
                Ingeniería & Docencia Universitaria
              </span>
            </div>
            <h2 class="font-display text-2xl font-black tracking-tight md:text-3xl">
              {t('about.title')}
            </h2>
            <p
              class="text-sm leading-relaxed text-fg-muted-light dark:text-fg-muted-dark md:text-base"
            >
              {t('home.about_summary')}
            </p>
            <div class="pt-2">
              <Button href={translatePath('/about')} variant="primary" size="sm">
                Conocer más sobre mi perfil
                <span slot="suffix">→</span>
              </Button>
            </div>
          </div>

          <div
            class="space-y-3 border-2 border-black bg-zinc-100 p-4 dark:border-white dark:bg-zinc-800 md:col-span-4"
          >
            <h3
              class="font-display text-sm font-black uppercase tracking-wider text-black dark:text-white"
            >
              Puntos Destacados
            </h3>
            <ul class="space-y-2.5 font-mono text-xs text-fg-muted-light dark:text-fg-muted-dark">
              <li class="flex items-center gap-2">
                <Icon name="ph:graduation-cap-bold" class="h-4 w-4 shrink-0 text-pink-600 dark:text-accent-pink" />
                <span><strong>Ing. en Informática</strong> (UNSL)</span>
              </li>
              <li class="flex items-center gap-2">
                <Icon name="ph:globe-bold" class="h-4 w-4 shrink-0 text-cyan-600 dark:text-accent-cyan" />
                <span><strong>Arquitecto de software</strong></span>
              </li>
              <li class="flex items-center gap-2">
                <Icon name="ph:cpu-bold" class="h-4 w-4 shrink-0 text-lime-600 dark:text-accent-lime" />
                <span><strong>Especialista en IA</strong></span>
              </li>
              <li class="flex items-center gap-2">
                <Icon name="ph:chalkboard-teacher-bold" class="h-4 w-4 shrink-0 text-amber-600 dark:text-accent-yellow" />
                <span><strong>Docente Universitario</strong></span>
              </li>
            </ul>
          </div>
        </div>
      </Card>
    </section>

    <!-- Featured Projects Section -->
    <section class="space-y-8">
      <div class="reveal-on-scroll">
        <SectionHeader
          number="01"
          title={t('project.featured')}
          subtitle="Sistemas en producción, agentes de inteligencia artificial y proyectos destacados."
          highlightColor="pink"
        />
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          featuredProjects.map((project, index) => {
            const slug = project.id.replace(/^es\//, '');
            const isDev = project.data.status === 'en-desarrollo';
            const delayClass = `reveal-delay-${((index % 3) + 1) * 100}`;

            return (
              <div class={`reveal-on-scroll ${delayClass} flex h-full`}>
                <Card
                  variant="default"
                  shadow="lg"
                  hoverTilt={index % 2 === 0 ? 'left' : 'right'}
                  class="flex flex-1 flex-col justify-between"
                >
                  <div>
                    <div class="mb-4 flex items-center justify-between gap-2">
                      <Badge color={isDev ? 'lime' : 'cyan'} pulse={isDev} size="sm">
                        {isDev ? t('project.status.in_progress') : t('project.status.completed')}
                      </Badge>
                      <span class="font-mono text-xs font-bold text-fg-muted-light dark:text-fg-muted-dark">
                        {formatDate(project.data.pubDate, lang, {
                          year: 'numeric',
                          month: 'short',
                        })}
                      </span>
                    </div>

                    <a href={translatePath(`/proyectos/${slug}`)} class="group mb-3 inline-block">
                      <h3 class="font-display text-2xl font-black tracking-tight transition-colors group-hover:text-accent-pink">
                        {project.data.title}
                      </h3>
                    </a>

                    <p class="mb-6 text-sm leading-relaxed text-fg-muted-light dark:text-fg-muted-dark">
                      {project.data.description}
                    </p>
                  </div>

                  <div>
                    <div class="mb-6 flex flex-wrap gap-2">
                      {project.data.tags.map((tag) => (
                        <Tag>{tag}</Tag>
                      ))}
                    </div>

                    <div class="flex items-center gap-3 border-t-2 border-black/10 pt-4 dark:border-white/10">
                      <Button href={translatePath(`/proyectos/${slug}`)} variant="primary" size="sm">
                        {t('common.view_project')}
                        <span slot="suffix">→</span>
                      </Button>
                      {project.data.liveUrl ? (
                        <Button
                          href={project.data.liveUrl}
                          target="_blank"
                          variant="secondary"
                          size="sm"
                        >
                          {t('project.live_demo')}
                          <span slot="suffix">↗</span>
                        </Button>
                      ) : project.data.repositoryUrl ? (
                        <Button
                          href={project.data.repositoryUrl}
                          target="_blank"
                          variant="secondary"
                          size="sm"
                        >
                          {t('project.source_code')}
                          <span slot="suffix">↗</span>
                        </Button>
                      ) : null}
                    </div>
                  </div>
                </Card>
              </div>
            );
          })
        }
      </div>

      <div class="reveal-on-scroll pt-4 text-center">
        <Button href={translatePath('/proyectos')} variant="secondary" size="md">
          {t('project.view_all')} ({allProjects.length})
          <span slot="suffix">→</span>
        </Button>
      </div>
    </section>

    <!-- Latest Blog Posts Section -->
    <section class="space-y-8">
      <div class="reveal-on-scroll">
        <SectionHeader
          number="02"
          title={t('home.latest_articles')}
          subtitle={t('home.latest_articles_desc')}
          highlightColor="yellow"
        />
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {
          latestPosts.map((post, index) => {
            const slug = post.id.replace(/^es\//, '');
            const delayClass = `reveal-delay-${((index % 2) + 1) * 100}`;

            return (
              <div class={`reveal-on-scroll ${delayClass} flex h-full`}>
                <Card
                  variant="default"
                  shadow="lg"
                  hoverTilt={index % 2 === 0 ? 'right' : 'left'}
                  class="flex flex-1 flex-col justify-between"
                >
                  <div>
                    <div class="mb-4 flex items-center justify-between gap-2">
                      <Badge color="pink" size="sm">
                        BLOG
                      </Badge>
                      <span class="font-mono text-xs font-bold text-fg-muted-light dark:text-fg-muted-dark">
                        {formatDate(post.data.pubDate, lang, {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric',
                        })}
                      </span>
                    </div>

                    <a href={translatePath(`/blog/${slug}`)} class="group mb-3 inline-block">
                      <h3 class="font-display text-2xl font-black tracking-tight transition-colors group-hover:text-accent-pink">
                        {post.data.title}
                      </h3>
                    </a>

                    <p class="mb-6 text-sm leading-relaxed text-fg-muted-light dark:text-fg-muted-dark">
                      {post.data.description}
                    </p>
                  </div>

                  <div>
                    <div class="mb-6 flex flex-wrap gap-2">
                      {post.data.tags.map((tag) => (
                        <Tag>{tag}</Tag>
                      ))}
                    </div>

                    <div class="flex justify-end border-t-2 border-black/10 pt-4 dark:border-white/10">
                      <Button href={translatePath(`/blog/${slug}`)} variant="primary" size="sm">
                        {t('common.read_more')}
                        <span slot="suffix">→</span>
                      </Button>
                    </div>
                  </div>
                </Card>
              </div>
            );
          })
        }
      </div>

      <div class="reveal-on-scroll pt-4 text-center">
        <Button href={translatePath('/blog')} variant="secondary" size="md">
          {t('home.view_all_posts')}
          <span slot="suffix">→</span>
        </Button>
      </div>
    </section>

    <!-- Contact CTA Banner -->
    <section class="reveal-on-scroll reveal-pop">
      <div
        class="flex flex-col items-center justify-between gap-6 border-4 border-black bg-accent-cyan p-8 text-black shadow-brutal-xl dark:border-white md:flex-row md:p-12"
      >
        <div class="space-y-2 text-center md:text-left">
          <h2 class="font-display text-3xl font-black text-black md:text-4xl">
            {t('common.get_in_touch')}
          </h2>
          <p class="max-w-xl text-base font-medium text-zinc-900">
            {t('contact.subtitle')}
          </p>
        </div>

        <Button href={translatePath('/contact')} variant="pink" size="lg">
          <Icon name="ph:lightning-bold" slot="prefix" class="h-5 w-5" />
          {t('hero.cta_contact')}
        </Button>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function initScrollReveal() {
    const reveals = document.querySelectorAll('.reveal-on-scroll:not(.is-revealed)');
    if (!reveals.length) return;

    if (!('IntersectionObserver' in window)) {
      reveals.forEach((el) => el.classList.add('is-revealed'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        root: null,
        threshold: 0.1,
        rootMargin: '0px 0px -30px 0px',
      }
    );

    reveals.forEach((el) => observer.observe(el));
  }

  // Initialize on load and on Astro View Transitions
  initScrollReveal();
  document.addEventListener('astro:page-load', initScrollReveal);
</script>

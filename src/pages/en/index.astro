---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";
import Badge from "@components/Badge.astro";
import Tag from "@components/Tag.astro";
import SectionHeader from "@components/SectionHeader.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Get projects and blog posts for English
const allProjects = await getCollection("proyectos", ({ id }) => id.startsWith("en/"));
allProjects.sort((a, b) => {
  if (a.data.status === "en-desarrollo" && b.data.status !== "en-desarrollo") return -1;
  if (a.data.status !== "en-desarrollo" && b.data.status === "en-desarrollo") return 1;
  return b.data.pubDate.getTime() - a.data.pubDate.getTime();
});
const featuredProjects = allProjects.filter((p) => p.data.featured);

const allPosts = await getCollection("blog", ({ id, data }) => id.startsWith("en/") && !data.draft);
allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const latestPosts = allPosts.slice(0, 2);
---

<BaseLayout
  title="Fabrizio José Riera Bauer — Informatics Engineer & FullStack"
  description={t("hero.desc")}
>
  <div class="space-y-16">
    <!-- Hero Section -->
    <section>
      <div class="p-6 md:p-12 bg-accent-yellow text-black border-4 border-black dark:border-white shadow-brutal-xl space-y-6">
        <div>
          <Badge color="dark" pulse={true} size="md">
            {t("hero.badge")}
          </Badge>
        </div>

        <h1 class="font-display font-black text-4xl sm:text-6xl md:text-7xl tracking-tight leading-none text-black">
          {t("hero.title")}
        </h1>

        <p class="font-mono text-base sm:text-xl font-bold text-black">
          {t("hero.role")}
        </p>

        <p class="text-base sm:text-lg max-w-2xl text-zinc-900 leading-relaxed font-medium">
          {t("hero.desc")}
        </p>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <Button href={translatePath("/proyectos")} variant="pink" size="lg">
            <span slot="prefix">⚡</span>
            {t("hero.cta_projects")}
          </Button>
          <Button href={translatePath("/about")} variant="secondary" size="lg">
            {t("hero.cta_about")}
            <span slot="suffix">→</span>
          </Button>
          <Button href={translatePath("/contact")} variant="cyan" size="lg">
            {t("hero.cta_contact")}
            <span slot="suffix">✉</span>
          </Button>
        </div>
      </div>
    </section>

    <!-- About Me Snippet Section -->
    <section>
      <Card variant="default" shadow="lg">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
          <div class="md:col-span-8 space-y-4">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 bg-accent-lime inline-block border border-black dark:border-white"></span>
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-fg-muted-light dark:text-fg-muted-dark">
                Engineering & University Lecturing
              </span>
            </div>
            <h2 class="font-display font-black text-2xl md:text-3xl tracking-tight">
              {t("about.title")}
            </h2>
            <p class="text-sm md:text-base text-fg-muted-light dark:text-fg-muted-dark leading-relaxed">
              {t("home.about_summary")}
            </p>
            <div class="pt-2">
              <Button href={translatePath("/about")} variant="primary" size="sm">
                Learn more about my background
                <span slot="suffix">→</span>
              </Button>
            </div>
          </div>

          <div class="md:col-span-4 p-4 bg-zinc-100 dark:bg-zinc-800 border-2 border-black dark:border-white space-y-3">
            <h3 class="font-display font-black text-sm uppercase tracking-wider text-black dark:text-white">
              Key Highlights
            </h3>
            <ul class="font-mono text-xs space-y-2 text-fg-muted-light dark:text-fg-muted-dark">
              <li>🎓 <strong>Informatics Engineer</strong> (UNSL)</li>
              <li>🏛️ <strong>University Lecturer</strong></li>
              <li>🤖 <strong>AI & RAG Specialist</strong></li>
              <li>🌐 <strong>FullStack Web Architect</strong></li>
            </ul>
          </div>
        </div>
      </Card>
    </section>

    <!-- Featured Projects Section -->
    <section class="space-y-8">
      <SectionHeader
        number="01"
        title={t("project.featured")}
        subtitle="Production platforms, conversational AI agents, and featured software."
        highlightColor="pink"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          featuredProjects.map((project) => {
            const slug = project.id.replace(/^en\//, "");
            const isDev = project.data.status === "en-desarrollo";

            return (
              <Card
                variant="default"
                shadow="lg"
                hoverTilt="left"
                class="flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 mb-4">
                    <Badge
                      color={isDev ? "lime" : "cyan"}
                      pulse={isDev}
                      size="sm"
                    >
                      {isDev ? t("project.status.in_progress") : t("project.status.completed")}
                    </Badge>
                    <span class="font-mono text-xs text-fg-muted-light dark:text-fg-muted-dark font-bold">
                      {project.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short" })}
                    </span>
                  </div>

                  <a
                    href={translatePath(`/proyectos/${slug}`)}
                    class="group inline-block mb-3"
                  >
                    <h3 class="font-display font-black text-2xl tracking-tight group-hover:text-accent-pink transition-colors">
                      {project.data.title}
                    </h3>
                  </a>

                  <p class="text-sm text-fg-muted-light dark:text-fg-muted-dark mb-6 leading-relaxed">
                    {project.data.description}
                  </p>
                </div>

                <div>
                  <div class="flex flex-wrap gap-2 mb-6">
                    {project.data.tags.map((tag) => (
                      <Tag>{tag}</Tag>
                    ))}
                  </div>

                  <div class="flex items-center gap-3 pt-4 border-t-2 border-black/10 dark:border-white/10">
                    <Button
                      href={translatePath(`/proyectos/${slug}`)}
                      variant="primary"
                      size="sm"
                    >
                      {t("common.view_project")}
                      <span slot="suffix">→</span>
                    </Button>
                    {project.data.liveUrl && (
                      <Button
                        href={project.data.liveUrl}
                        target="_blank"
                        variant="secondary"
                        size="sm"
                      >
                        {t("project.live_demo")}
                        <span slot="suffix">↗</span>
                      </Button>
                    )}
                  </div>
                </div>
              </Card>
            );
          })
        }
      </div>

      <div class="text-center pt-4">
        <Button href={translatePath("/proyectos")} variant="secondary" size="md">
          {t("project.view_all")} ({allProjects.length})
          <span slot="suffix">→</span>
        </Button>
      </div>
    </section>

    <!-- Latest Blog Posts Section -->
    <section class="space-y-8">
      <SectionHeader
        number="02"
        title={t("home.latest_articles")}
        subtitle={t("home.latest_articles_desc")}
        highlightColor="yellow"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          latestPosts.map((post) => {
            const slug = post.id.replace(/^en\//, "");
            return (
              <Card
                variant="default"
                shadow="lg"
                hoverTilt="right"
                class="flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 mb-4">
                    <Badge color="pink" size="sm">
                      BLOG
                    </Badge>
                    <span class="font-mono text-xs text-fg-muted-light dark:text-fg-muted-dark font-bold">
                      {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                    </span>
                  </div>

                  <a
                    href={translatePath(`/blog/${slug}`)}
                    class="group inline-block mb-3"
                  >
                    <h3 class="font-display font-black text-2xl tracking-tight group-hover:text-accent-pink transition-colors">
                      {post.data.title}
                    </h3>
                  </a>

                  <p class="text-sm text-fg-muted-light dark:text-fg-muted-dark mb-6 leading-relaxed">
                    {post.data.description}
                  </p>
                </div>

                <div>
                  <div class="flex flex-wrap gap-2 mb-6">
                    {post.data.tags.map((tag) => (
                      <Tag>{tag}</Tag>
                    ))}
                  </div>

                  <div class="pt-4 border-t-2 border-black/10 dark:border-white/10 flex justify-end">
                    <Button
                      href={translatePath(`/blog/${slug}`)}
                      variant="primary"
                      size="sm"
                    >
                      {t("common.read_more")}
                      <span slot="suffix">→</span>
                    </Button>
                  </div>
                </div>
              </Card>
            );
          })
        }
      </div>

      <div class="text-center pt-4">
        <Button href={translatePath("/blog")} variant="secondary" size="md">
          {t("home.view_all_posts")}
          <span slot="suffix">→</span>
        </Button>
      </div>
    </section>

    <!-- Contact CTA Banner -->
    <section>
      <div class="p-8 md:p-12 bg-accent-cyan text-black border-4 border-black dark:border-white shadow-brutal-xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left">
          <h2 class="font-display font-black text-3xl md:text-4xl text-black">
            {t("common.get_in_touch")}
          </h2>
          <p class="text-base text-zinc-900 font-medium max-w-xl">
            {t("contact.subtitle")}
          </p>
        </div>

        <Button href={translatePath("/contact")} variant="pink" size="lg">
          <span slot="prefix">⚡</span>
          {t("hero.cta_contact")}
        </Button>
      </div>
    </section>
  </div>
</BaseLayout>

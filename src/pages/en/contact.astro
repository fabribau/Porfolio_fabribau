---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/SectionHeader.astro';
import Card from '@components/Card.astro';
import ContactForm from '@components/ContactForm.astro';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`${t('contact.title')} — Fabrizio Riera Bauer`} description={t('contact.subtitle')}>
  <div class="space-y-12">
    <!-- Header -->
    <SectionHeader
      number="03"
      title={t('contact.title')}
      subtitle={t('contact.subtitle')}
      highlightColor="cyan"
    />

    <!-- Main Grid -->
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12">
      <!-- Contact Form (7 cols) -->
      <div class="lg:col-span-7">
        <ContactForm lang="en" />
      </div>

      <!-- Direct Channels (5 cols) -->
      <div class="space-y-6 lg:col-span-5">
        <!-- Email Direct Card -->
        <Card variant="yellow" shadow="lg">
          <div class="space-y-3 text-black">
            <span class="flex items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-wider">
              <Icon name="ph:envelope-simple-bold" class="h-4 w-4 shrink-0" />
              {t('contact.email_label')}
            </span>
            <p class="break-all font-display text-xl font-black sm:text-2xl">
              fabriziojriera@gmail.com
            </p>
            <div class="flex flex-wrap gap-2 pt-2">
              <a
                href="mailto:fabriziojriera@gmail.com"
                class="brutal-btn inline-flex items-center gap-1.5 border-2 border-black bg-black px-3 py-1.5 font-mono text-xs font-bold text-white shadow-brutal-sm transition-all hover:bg-white hover:text-black"
              >
                <Icon name="ph:paper-plane-tilt-bold" class="h-3.5 w-3.5" />
                Send Email
              </a>
              <button
                id="copy-email-btn"
                type="button"
                data-email="fabriziojriera@gmail.com"
                class="brutal-btn inline-flex items-center gap-1.5 border-2 border-black bg-white px-3 py-1.5 font-mono text-xs font-bold text-black shadow-brutal-sm transition-all hover:bg-black hover:text-white"
              >
                <Icon name="ph:copy-bold" class="h-3.5 w-3.5" />
                <span class="btn-text">{t('common.copy')}</span>
              </button>
            </div>
          </div>
        </Card>

        <!-- WhatsApp Direct Card -->
        <Card variant="lime" shadow="lg">
          <div class="space-y-3 text-black">
            <span class="flex items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-wider">
              <Icon name="ph:whatsapp-logo-bold" class="h-4 w-4 shrink-0" />
              {t('contact.whatsapp_label')}
            </span>
            <p class="font-display text-xl font-black sm:text-2xl">+54 9 2664 02-4353</p>
            <div class="flex flex-wrap gap-2 pt-2">
              <a
                href="https://wa.me/5492664024353"
                target="_blank"
                rel="noopener noreferrer"
                class="brutal-btn inline-flex items-center gap-1.5 border-2 border-black bg-black px-3 py-1.5 font-mono text-xs font-bold text-white shadow-brutal-sm transition-all hover:bg-white hover:text-black"
              >
                <Icon name="ph:whatsapp-logo-bold" class="h-3.5 w-3.5" />
                {t('contact.whatsapp_cta')}
                <Icon name="ph:arrow-up-right-bold" class="h-3.5 w-3.5" />
              </a>
              <button
                id="copy-phone-btn"
                type="button"
                data-phone="+5492664024353"
                class="brutal-btn inline-flex items-center gap-1.5 border-2 border-black bg-white px-3 py-1.5 font-mono text-xs font-bold text-black shadow-brutal-sm transition-all hover:bg-black hover:text-white"
              >
                <Icon name="ph:copy-bold" class="h-3.5 w-3.5" />
                <span class="btn-text">Copy Number</span>
              </button>
            </div>
          </div>
        </Card>

        <!-- Social Channels -->
        <Card variant="default" shadow="md">
          <h3 class="mb-4 flex items-center gap-2 font-display text-lg font-black">
            <span class="inline-block h-2.5 w-2.5 bg-accent-pink"></span>
            {t('contact.direct_channels')}
          </h3>

          <div class="space-y-3">
            <a
              href="https://linkedin.com/in/fabrizio-bauer"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between border-2 border-black bg-zinc-50 p-3 transition-colors hover:bg-accent-cyan hover:text-black dark:border-white dark:bg-zinc-800"
            >
              <span class="flex items-center gap-2 font-display text-sm font-bold">
                <Icon name="ph:linkedin-logo-bold" class="h-5 w-5 shrink-0" />
                LinkedIn
              </span>
              <span class="font-mono text-xs font-bold">in/fabrizio-bauer ↗</span>
            </a>

            <a
              href="https://github.com/fabribau"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between border-2 border-black bg-zinc-50 p-3 transition-colors hover:bg-accent-lime hover:text-black dark:border-white dark:bg-zinc-800"
            >
              <span class="flex items-center gap-2 font-display text-sm font-bold">
                <Icon name="ph:github-logo-bold" class="h-5 w-5 shrink-0" />
                GitHub
              </span>
              <span class="font-mono text-xs font-bold">@fabribau ↗</span>
            </a>
          </div>
        </Card>

        <!-- Status & Availability -->
        <Card variant="cyan" shadow="md">
          <div class="space-y-2 text-black">
            <span class="flex items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-wider">
              <Icon name="ph:lightning-bold" class="h-4 w-4 shrink-0" />
              {t('contact.status_label')}
            </span>
            <p class="font-display text-base font-black sm:text-lg">
              {t('contact.status_value')}
            </p>
            <p class="flex items-center gap-1.5 font-mono text-xs font-medium">
              <Icon name="ph:map-pin-bold" class="h-3.5 w-3.5 shrink-0" />
              {t('about.location_desc')}
            </p>
          </div>
        </Card>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function setupContactPage() {
    const copyEmailBtn = document.getElementById('copy-email-btn');
    if (copyEmailBtn) {
      const textSpan = copyEmailBtn.querySelector('.btn-text');
      const originalText = textSpan?.textContent || '';
      copyEmailBtn.onclick = () => {
        const email = copyEmailBtn.getAttribute('data-email') || 'fabriziojriera@gmail.com';
        navigator.clipboard.writeText(email).then(() => {
          if (textSpan) textSpan.textContent = 'Copied!';
          setTimeout(() => {
            if (textSpan) textSpan.textContent = originalText;
          }, 2000);
        });
      };
    }

    const copyPhoneBtn = document.getElementById('copy-phone-btn');
    if (copyPhoneBtn) {
      const textSpan = copyPhoneBtn.querySelector('.btn-text');
      const originalText = textSpan?.textContent || '';
      copyPhoneBtn.onclick = () => {
        const phone = copyPhoneBtn.getAttribute('data-phone') || '+5492664024353';
        navigator.clipboard.writeText(phone).then(() => {
          if (textSpan) textSpan.textContent = 'Copied!';
          setTimeout(() => {
            if (textSpan) textSpan.textContent = originalText;
          }, 2000);
        });
      };
    }
  }

  setupContactPage();
  document.addEventListener('astro:page-load', setupContactPage);
</script>

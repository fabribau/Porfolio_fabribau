---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import Badge from "@components/Badge.astro";
import Tag from "@components/Tag.astro";
import { getCollection, render } from "astro:content";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

export async function getStaticPaths() {
  const projects = await getCollection("proyectos", ({ id }) => id.startsWith("en/"));
  return projects.map((project) => ({
    params: { slug: project.id.replace(/^en\//, "") },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const isDev = project.data.status === "en-desarrollo";
---

<BaseLayout
  title={`${project.data.title} — Projects`}
  description={project.data.description}
>
  <article class="space-y-8">
    <!-- Back button -->
    <div>
      <Button href={translatePath("/proyectos")} variant="secondary" size="sm">
        {t("common.back_projects")}
      </Button>
    </div>

    <!-- Project Header Box -->
    <header class="p-6 md:p-10 bg-bg-surface-light dark:bg-bg-surface-dark border-4 border-black dark:border-white shadow-brutal-xl space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <Badge
          color={isDev ? "lime" : "cyan"}
          pulse={isDev}
          size="md"
        >
          {isDev ? t("project.status.in_progress") : t("project.status.completed")}
        </Badge>
        <span class="font-mono text-sm font-bold text-fg-muted-light dark:text-fg-muted-dark">
          {t("common.published_on")} {project.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        </span>
      </div>

      <h1 class="font-display font-black text-3xl sm:text-4xl md:text-6xl tracking-tight leading-tight">
        {project.data.title}
      </h1>

      <p class="text-base sm:text-lg text-fg-muted-light dark:text-fg-muted-dark max-w-3xl leading-relaxed font-medium">
        {project.data.description}
      </p>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 pt-2">
        {project.data.tags.map((tag) => (
          <Tag>{tag}</Tag>
        ))}
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4 pt-4 border-t-3 border-black/10 dark:border-white/10">
        {project.data.liveUrl && (
          <Button href={project.data.liveUrl} target="_blank" variant="primary" size="md">
            {t("project.live_demo")}
            <span slot="suffix">↗</span>
          </Button>
        )}
        {project.data.repositoryUrl && (
          <Button href={project.data.repositoryUrl} target="_blank" variant="secondary" size="md">
            {t("project.source_code")}
            <span slot="suffix">↗</span>
          </Button>
        )}
      </div>
    </header>

    <!-- Markdown Content Container -->
    <div class="p-6 md:p-10 bg-white dark:bg-zinc-900 border-4 border-black dark:border-white shadow-brutal-lg prose dark:prose-invert max-w-none font-sans prose-headings:font-display prose-headings:font-black prose-a:text-accent-pink dark:prose-a:text-accent-yellow prose-code:font-mono">
      <Content />
    </div>

    <!-- Bottom Navigation -->
    <div class="pt-6 flex justify-between items-center">
      <Button href={translatePath("/proyectos")} variant="secondary" size="md">
        {t("common.back_projects")}
      </Button>
      <Button href={translatePath("/contact")} variant="pink" size="md">
        {t("hero.cta_contact")}
        <span slot="suffix">⚡</span>
      </Button>
    </div>
  </article>
</BaseLayout>

---
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeader from "@components/SectionHeader.astro";
import Card from "@components/Card.astro";
import Badge from "@components/Badge.astro";
import Tag from "@components/Tag.astro";
import Button from "@components/Button.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const allProjects = await getCollection("proyectos", ({ id }) => id.startsWith("en/"));
allProjects.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
---

<BaseLayout
  title={`${t("projects.title")} — Fabrizio Bauer`}
  description={t("projects.subtitle")}
>
  <div class="space-y-12">
    <!-- Header -->
    <SectionHeader
      number="01"
      title={t("projects.title")}
      subtitle={t("projects.subtitle")}
      highlightColor="yellow"
    />

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        allProjects.map((project) => {
          const slug = project.id.replace(/^en\//, "");
          const isDev = project.data.status === "en-desarrollo";

          return (
            <Card
              variant="default"
              shadow="lg"
              hoverTilt="left"
              class="flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-4">
                  <Badge
                    color={isDev ? "lime" : "cyan"}
                    pulse={isDev}
                    size="sm"
                  >
                    {isDev ? t("project.status.in_progress") : t("project.status.completed")}
                  </Badge>
                  <span class="font-mono text-xs text-fg-muted-light dark:text-fg-muted-dark font-bold">
                    {project.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short" })}
                  </span>
                </div>

                <a
                  href={translatePath(`/proyectos/${slug}`)}
                  class="group inline-block mb-3"
                >
                  <h2 class="font-display font-black text-2xl md:text-3xl tracking-tight group-hover:text-accent-pink transition-colors">
                    {project.data.title}
                  </h2>
                </a>

                <p class="text-sm text-fg-muted-light dark:text-fg-muted-dark mb-6 leading-relaxed">
                  {project.data.description}
                </p>
              </div>

              <div>
                <div class="flex flex-wrap gap-2 mb-6">
                  {project.data.tags.map((tag) => (
                    <Tag>{tag}</Tag>
                  ))}
                </div>

                <div class="flex flex-wrap items-center gap-3 pt-4 border-t-2 border-black/10 dark:border-white/10">
                  <Button
                    href={translatePath(`/proyectos/${slug}`)}
                    variant="primary"
                    size="sm"
                  >
                    {t("common.read_more")}
                    <span slot="suffix">→</span>
                  </Button>

                  {project.data.liveUrl && (
                    <Button
                      href={project.data.liveUrl}
                      target="_blank"
                      variant="secondary"
                      size="sm"
                    >
                      {t("project.live_demo")}
                      <span slot="suffix">↗</span>
                    </Button>
                  )}

                  {project.data.repositoryUrl && (
                    <Button
                      href={project.data.repositoryUrl}
                      target="_blank"
                      variant="ghost"
                      size="sm"
                    >
                      {t("common.view_code")}
                    </Button>
                  )}
                </div>
              </div>
            </Card>
          );
        })
      }
    </div>
  </div>
</BaseLayout>

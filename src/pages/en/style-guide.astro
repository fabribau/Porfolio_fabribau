---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import Card from '@components/Card.astro';
import Badge from '@components/Badge.astro';
import Tag from '@components/Tag.astro';
import SectionHeader from '@components/SectionHeader.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout
  title="Neobrutalist UI Kit — Style Guide | Fabrizio Bauer"
  description="Component catalog, design tokens, and neobrutalist micro-interactions for fabribau.tech."
  noIndex={true}
>
  <!-- Page Header -->
  <div class="mb-12">
    <div class="mb-3 inline-block">
      <Badge color="yellow" pulse={true} size="md"> UI Kit </Badge>
    </div>
    <h1
      class="mb-3 font-display text-4xl font-black leading-none tracking-tight text-black dark:text-white md:text-6xl"
    >
      {t('styleguide.title')}
    </h1>
    <p
      class="mb-6 max-w-3xl font-mono text-base text-fg-muted-light dark:text-fg-muted-dark md:text-lg"
    >
      {t('styleguide.subtitle')}
    </p>
    <div>
      <Button href={translatePath('/')} variant="secondary" size="sm">
        <span slot="prefix">←</span>
        {t('styleguide.back_home')}
      </Button>
    </div>
  </div>

  <div class="space-y-16">
    <!-- 01. COLOR PALETTE -->
    <section>
      <SectionHeader
        number="01"
        title="Color Palette & Tokens"
        subtitle="Semantic surfaces and high-contrast saturated accents for light and dark mode."
        highlightColor="yellow"
      />

      <!-- Color Swatches: Accents -->
      <div class="mb-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6">
        <div
          class="border-3 border-black bg-accent-yellow p-4 text-center text-black shadow-brutal-sm dark:border-white"
        >
          <p class="font-display text-sm font-black">YELLOW</p>
          <p class="mt-1 font-mono text-xs font-bold">#FFE400</p>
        </div>
        <div
          class="border-3 border-black bg-accent-pink p-4 text-center text-white shadow-brutal-sm dark:border-white"
        >
          <p class="font-display text-sm font-black">MAGENTA</p>
          <p class="mt-1 font-mono text-xs font-bold">#FF3D8A</p>
        </div>
        <div
          class="border-3 border-black bg-accent-lime p-4 text-center text-black shadow-brutal-sm dark:border-white"
        >
          <p class="font-display text-sm font-black">LIME</p>
          <p class="mt-1 font-mono text-xs font-bold">#B4FF39</p>
        </div>
        <div
          class="border-3 border-black bg-accent-cyan p-4 text-center text-black shadow-brutal-sm dark:border-white"
        >
          <p class="font-display text-sm font-black">CYAN</p>
          <p class="mt-1 font-mono text-xs font-bold">#00F0FF</p>
        </div>
        <div
          class="border-3 border-black bg-accent-orange p-4 text-center text-white shadow-brutal-sm dark:border-white"
        >
          <p class="font-display text-sm font-black">ORANGE</p>
          <p class="mt-1 font-mono text-xs font-bold">#FF6B00</p>
        </div>
        <div
          class="border-3 border-black bg-accent-purple p-4 text-center text-white shadow-brutal-sm dark:border-white"
        >
          <p class="font-display text-sm font-black">PURPLE</p>
          <p class="mt-1 font-mono text-xs font-bold">#8B5CF6</p>
        </div>
      </div>

      <!-- Color Swatches: Base & Surface -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-4">
        <div
          class="border-3 border-black bg-[#F5F0E8] p-4 text-center text-[#0D0D0D] shadow-brutal-sm"
        >
          <p class="font-mono text-xs font-bold uppercase text-zinc-600">Light Base</p>
          <p class="font-display text-lg font-black">#F5F0E8</p>
        </div>
        <div
          class="border-3 border-black bg-[#FFFFFF] p-4 text-center text-[#0D0D0D] shadow-brutal-sm"
        >
          <p class="font-mono text-xs font-bold uppercase text-zinc-600">Light Surface</p>
          <p class="font-display text-lg font-black">#FFFFFF</p>
        </div>
        <div
          class="border-3 border-black bg-[#0D0D0D] p-4 text-center text-[#F5F0E8] shadow-brutal-sm dark:border-white"
        >
          <p class="font-mono text-xs font-bold uppercase text-zinc-400">Dark Base</p>
          <p class="font-display text-lg font-black">#0D0D0D</p>
        </div>
        <div
          class="border-3 border-black bg-[#181818] p-4 text-center text-[#F5F0E8] shadow-brutal-sm dark:border-white"
        >
          <p class="font-mono text-xs font-bold uppercase text-zinc-400">Dark Surface</p>
          <p class="font-display text-lg font-black">#181818</p>
        </div>
      </div>
    </section>

    <!-- 02. TYPOGRAPHY & HIGHLIGHTERS -->
    <section>
      <SectionHeader
        number="02"
        title="Typography & Highlighters"
        subtitle="Pairing Space Grotesk, Inter, and JetBrains Mono with neobrutalist highlighter effects."
        highlightColor="pink"
      />

      <div class="space-y-6">
        <Card variant="default">
          <div class="space-y-4">
            <div>
              <p
                class="mb-1 font-mono text-xs font-bold text-fg-muted-light dark:text-fg-muted-dark"
              >
                Display 900 (Space Grotesk)
              </p>
              <h3
                class="font-display text-3xl font-black leading-tight tracking-tight text-black dark:text-white md:text-5xl"
              >
                INFORMATICS ENGINEER & <span class="highlighter-yellow">FULLSTACK</span>
              </h3>
            </div>
            <div>
              <p
                class="mb-1 font-mono text-xs font-bold text-fg-muted-light dark:text-fg-muted-dark"
              >
                Highlighter Variants
              </p>
              <div
                class="flex flex-wrap gap-3 font-display text-xl font-black text-black dark:text-white md:text-2xl"
              >
                <span>Highlight <span class="highlighter-yellow">Yellow</span></span>
                <span>Highlight <span class="highlighter-pink">Magenta</span></span>
                <span>Highlight <span class="highlighter-lime">Lime</span></span>
                <span>Highlight <span class="highlighter-cyan">Cyan</span></span>
              </div>
            </div>
            <div>
              <p
                class="mb-1 font-mono text-xs font-bold text-fg-muted-light dark:text-fg-muted-dark"
              >
                Body Text (Inter)
              </p>
              <p
                class="max-w-3xl text-sm font-medium leading-relaxed text-fg-light dark:text-fg-dark md:text-base"
              >
                Software engineering focused on robust architecture, conversational AI agents with
                RAG, and modern interactive web experiences.
              </p>
            </div>
            <div>
              <p
                class="mb-1 font-mono text-xs font-bold text-fg-muted-light dark:text-fg-muted-dark"
              >
                Monospace (JetBrains Mono)
              </p>
              <p
                class="border-2 border-black bg-black/5 p-3 font-mono text-xs text-black dark:border-white dark:bg-white/5 dark:text-white md:text-sm"
              >
                const profile = &#123; role: "Software Engineer", focus: ["FullStack", "RAG",
                "Teaching"] &#125;;
              </p>
            </div>
          </div>
        </Card>
      </div>
    </section>

    <!-- 03. BUTTONS & ACTIONS -->
    <section>
      <SectionHeader
        number="03"
        title="Buttons & Actions"
        subtitle="Color variants, size tiers, and tactile click response (physical button press mechanics)."
        highlightColor="lime"
      />

      <div class="space-y-6">
        <!-- Button Variants -->
        <Card variant="default">
          <p
            class="mb-3 font-mono text-xs font-bold uppercase tracking-wider text-black dark:text-white"
          >
            Color Variants
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <Button variant="primary">Primary (Yellow)</Button>
            <Button variant="pink">Pink</Button>
            <Button variant="lime">Lime</Button>
            <Button variant="cyan">Cyan</Button>
            <Button variant="purple">Purple</Button>
            <Button variant="secondary">Secondary</Button>
            <Button variant="outline">Outline</Button>
            <Button variant="danger">Danger</Button>
            <Button variant="ghost">Ghost</Button>
          </div>
        </Card>

        <!-- Button Sizes & States -->
        <Card variant="default">
          <p
            class="mb-3 font-mono text-xs font-bold uppercase tracking-wider text-black dark:text-white"
          >
            Sizes & States
          </p>
          <div class="mb-6 flex flex-wrap items-center gap-4">
            <Button size="sm" variant="primary">Small (sm)</Button>
            <Button size="md" variant="primary">Medium (md)</Button>
            <Button size="lg" variant="primary">Large (lg)</Button>
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <Button variant="primary" disabled={true}>Disabled</Button>
            <Button variant="pink">
              <span slot="prefix">⚡</span>
              Prefix Icon
            </Button>
            <Button variant="lime">
              Suffix Icon
              <span slot="suffix">↗</span>
            </Button>
          </div>
        </Card>
      </div>
    </section>

    <!-- 04. CARDS & CONTAINERS -->
    <section>
      <SectionHeader
        number="04"
        title="Cards & Containers"
        subtitle="Heavy borders, customizable offset shadows, reactive micro-tilt, and structured slots."
        highlightColor="cyan"
      />

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <Card variant="default" shadow="md">
          <div slot="header" class="flex items-center justify-between">
            <span class="text-black dark:text-white">Card Default</span>
            <Badge color="yellow">Base</Badge>
          </div>
          <p class="mb-4 text-sm leading-relaxed text-fg-light dark:text-fg-dark">
            Standard container with white/charcoal surface, 3px border, and 4px hard offset shadow.
          </p>
          <Button variant="secondary" size="sm">Action</Button>
        </Card>

        <Card variant="yellow" shadow="lg" hoverTilt="left">
          <div slot="header" class="flex items-center justify-between">
            <span class="text-black">Card Yellow Tilt</span>
            <Badge color="dark">Tilt Left</Badge>
          </div>
          <p class="mb-4 text-sm font-medium leading-relaxed text-black">
            Hover over this card to witness dynamic micro-rotation to the left with a 6px deep
            shadow.
          </p>
          <Button variant="secondary" size="sm">Explore</Button>
        </Card>

        <Card variant="pink" shadow="lg" hoverTilt="right">
          <div slot="header" class="flex items-center justify-between text-white">
            <span>Card Pink Tilt</span>
            <Badge color="lime">Tilt Right</Badge>
          </div>
          <p class="mb-4 text-sm font-medium leading-relaxed text-white">
            Dynamic right-leaning micro-tilt with high-energy neon magenta background and bold
            contrast.
          </p>
          <Button variant="secondary" size="sm">View More</Button>
        </Card>
      </div>
    </section>

    <!-- 05. BADGES & TAGS -->
    <section>
      <SectionHeader
        number="05"
        title="Badges & Tags"
        subtitle="Status labels with animated radar-pulse and monospaced tech chips."
        highlightColor="yellow"
      />

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <Card variant="default">
          <p
            class="mb-4 font-mono text-xs font-bold uppercase tracking-wider text-black dark:text-white"
          >
            Badges with & without Radar Pulse
          </p>
          <div class="flex flex-wrap gap-3">
            <Badge color="lime" pulse={true}>In progress</Badge>
            <Badge color="yellow" pulse={true}>Available</Badge>
            <Badge color="pink">Research</Badge>
            <Badge color="cyan">Completed</Badge>
            <Badge color="purple">Academic</Badge>
            <Badge color="dark">Backend</Badge>
            <Badge color="white">Frontend</Badge>
          </div>
        </Card>

        <Card variant="default">
          <p
            class="mb-4 font-mono text-xs font-bold uppercase tracking-wider text-black dark:text-white"
          >
            Technology Tags (Interactive)
          </p>
          <div class="flex flex-wrap gap-2">
            <Tag active={true}>Astro</Tag>
            <Tag interactive={true}>TypeScript</Tag>
            <Tag interactive={true}>TailwindCSS</Tag>
            <Tag interactive={true}>Cloudflare</Tag>
            <Tag interactive={true}>Python</Tag>
            <Tag interactive={true}>RAG</Tag>
            <Tag interactive={true}>Java</Tag>
            <Tag interactive={true}>Spring</Tag>
          </div>
        </Card>
      </div>
    </section>

    <!-- 06. DIFFERENTIATING SIGNATURES -->
    <section>
      <SectionHeader
        number="06"
        title="Micro-interactions & Signatures"
        subtitle="The 4 core visual pillars of the fabribau.tech design system."
        highlightColor="pink"
      />

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="brutal-box p-5">
          <div
            class="mb-3 flex h-8 w-8 items-center justify-center border-2 border-black bg-accent-yellow font-mono text-sm font-bold text-black dark:border-white"
          >
            01
          </div>
          <h4 class="mb-1 font-display text-base font-bold text-black dark:text-white">
            Tactile Press
          </h4>
          <p class="text-xs leading-relaxed text-fg-muted-light dark:text-fg-muted-dark">
            Buttons translate diagonally on click while reducing shadow to 0px, simulating
            mechanical keys.
          </p>
        </div>

        <div class="brutal-box p-5">
          <div
            class="mb-3 flex h-8 w-8 items-center justify-center border-2 border-black bg-accent-pink font-mono text-sm font-bold text-white dark:border-white"
          >
            02
          </div>
          <h4 class="mb-1 font-display text-base font-bold text-black dark:text-white">
            Highlighter Mark
          </h4>
          <p class="text-xs leading-relaxed text-fg-muted-light dark:text-fg-muted-dark">
            Fluorescent marker effects over key concepts for immediate visual impact and hierarchy.
          </p>
        </div>

        <div class="brutal-box p-5">
          <div
            class="mb-3 flex h-8 w-8 items-center justify-center border-2 border-black bg-accent-lime font-mono text-sm font-bold text-black dark:border-white"
          >
            03
          </div>
          <h4 class="mb-1 font-display text-base font-bold text-black dark:text-white">
            Dynamic Tilt
          </h4>
          <p class="text-xs leading-relaxed text-fg-muted-light dark:text-fg-muted-dark">
            Subtle ±1 degree tilt on project cards during cursor hover, bringing the grid to life.
          </p>
        </div>

        <div class="brutal-box p-5">
          <div
            class="mb-3 flex h-8 w-8 items-center justify-center border-2 border-black bg-accent-cyan font-mono text-sm font-bold text-black dark:border-white"
          >
            04
          </div>
          <h4 class="mb-1 font-display text-base font-bold text-black dark:text-white">
            Radar Status
          </h4>
          <p class="text-xs leading-relaxed text-fg-muted-light dark:text-fg-muted-dark">
            Continuous pulse animation on badges signaling live availability and ongoing projects.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

---
import { ClientRouter } from 'astro:transitions';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import SEO from '@components/SEO.astro';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  article?: {
    pubDate?: Date;
    author?: string;
    tags?: string[];
  };
  project?: {
    pubDate?: Date;
    status?: string;
    tags?: string[];
  };
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = 'Fabrizio José Riera Bauer — Portfolio',
  description = t('hero.desc'),
  image = '/og-image.svg',
  noIndex = false,
  article,
  project,
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FFE400" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0D0D0D" media="(prefers-color-scheme: dark)" />

    <!-- Local Font Preloads for High Performance & Zero CLS -->
    <link
      rel="preload"
      href="/fonts/SpaceGrotesk-VariableFont_wght.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Inter-VariableFont_opsz,wght.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />

    <!-- SEO & Structured Data -->
    <SEO
      title={title}
      description={description}
      image={image}
      lang={lang}
      noIndex={noIndex}
      article={article}
      project={project}
    />

    <!-- Zero-FOUC Inline Theme Script -->
    <script is:inline>
      function applyTheme() {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored ? stored : prefersDark ? 'dark' : 'light';

          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          localStorage.setItem('theme', theme);
        } catch (e) {
          // Fallback if localStorage is inaccessible
        }
      }

      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>

    <!-- Astro View Transitions -->
    <ClientRouter />
  </head>
  <body
    class="flex min-h-screen flex-col bg-bg-light font-sans text-fg-light transition-colors duration-200 dark:bg-bg-dark dark:text-fg-dark"
  >
    <!-- Navbar Component -->
    <Navbar />

    <!-- Main Content Container -->
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 md:py-12">
      <slot />
    </main>

    <!-- Footer Component -->
    <Footer />
  </body>
</html>

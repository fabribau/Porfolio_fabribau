# ==============================================================================
# VARIABLES DE ENTORNO — PORTFOLIO Fabrizio Riera Bauer (fabribau.tech)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RESEND (Servicio transaccional de Email)
# ------------------------------------------------------------------------------
# API Key obtenida desde https://resend.com/api-keys
# En local o sin configurar, el sistema entra en modo 'Mock/Dev' automático.
RESEND_API_KEY=re_your_api_key_here

# Remitente de los correos:
# - Para pruebas locales antes de verificar dominio: "onboarding@resend.dev"
# - Para producción con dominio verificado: "Fabrizio Riera Bauer <contacto@fabribau.tech>"
RESEND_FROM_EMAIL="Fabrizio Riera Bauer <contacto@fabribau.tech>"

# Tu casilla de email donde deseas recibir las consultas de contacto:
CONTACT_RECIPIENT_EMAIL=fabriziojriera@gmail.com


# ------------------------------------------------------------------------------
# 2. CLOUDFLARE TURNSTILE (Protección Anti-Bot / Captcha Invisible)
# ------------------------------------------------------------------------------
# Claves de prueba oficiales de Cloudflare (funcionan en localhost inmediatamente):
# SiteKey test (siempre pasa): 1x00000000000000000000AA
# SecretKey test (siempre pasa): 1x0000000000000000000000000000000AA

# Clave pública para el widget de Turnstile en el frontend:
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Clave secreta para la verificación server-side en el endpoint /api/contact:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
